// CyQuote 云端语录数据（API 目录）
// 维护说明：
// - 顶层键即为 category，可自由增删分类。部署后 /api/v1/quote/categories 会自动返回这里的分类列表。
// - 每条语录包含 value（正文）、author（作者，可留空）、from（作品/出处，可留空）。
// - 支持 // 行注释与 /* 块注释 */。
// - 修改后提交推送即可，API 会读取本文件。

{
  "崩铁": [
    { "value": "但，即便命运确凿不移，无论它要将世界带向何方，只要我们能够共同面对，那就没什么好害怕的，对吧？", "author": "德谬歌", "from": "HSR" },
    { "value": "逐火的命路——由我们改写！", "author": "德谬歌", "from": "HSR" },
    { "value": "让「人」向你证明——自「毁灭」的温床中，也能开出温柔的花。", "author": "德谬歌", "from": "HSR" },
    { "value": "是我们赢了，「真诚」才是永远的捷径。", "author": "德谬歌", "from": "HSR" },
    { "value": "因为世界对我温柔，我就长成温柔的模样。", "author": "德谬歌", "from": "HSR" },
    { "value": "逐火是从不断失却，走向坚定舍却的旅途。", "author": "德谬歌", "from": "HSR" },
    { "value": "以爱为始的故事，也一定以爱为终♪", "author": "德谬歌", "from": "HSR" },
    { "value": "每一段回忆，都化作涟漪。", "author": "德谬歌", "from": "HSR" },
    { "value": "下一页是空白呢，那我们一起写下吧？", "author": "德谬歌", "from": "HSR" },
    { "value": "扔下多余的烦恼，把笑容和决心一起打包，带向明天♪", "author": "德谬歌", "from": "HSR" },
    { "value": "虔诚的叩问会得到同等重量的回应。", "author": "德谬歌", "from": "HSR" },
    { "value": "只有诗人知道，故事之外，有多少挣扎和痛苦。", "author": "德谬歌", "from": "HSR" },
    { "value": "说不定，我的心中也藏着一个阴谋呢…一个能让每个人都收获幸福的阴谋~", "author": "德谬歌", "from": "HSR" },
    { "value": "这世上没有任何一种语言，一行文字，能托得起这段旅途的重量。", "author": "德谬歌", "from": "HSR" },
    { "value": "一篇轰轰烈烈的史诗，要多么华美的语句才能勾勒出它的尾声呢？", "author": "德谬歌", "from": "HSR" },
    { "value": "愿此行，终抵群星。", "author": "探索·了解·建立·连结·拯救", "from": "HSR" },
    { "value": "翁法罗斯最不缺少的奇迹，就是「战胜命运」。", "author": "德谬歌", "from": "HSR" },
    { "value": "记忆里的故乡总是一动不动，可回过神来，才发现命运早就偷走了时间。", "author": "德谬歌", "from": "HSR" },
    { "value": "生命是一首充满告别的诗，但只要被写进「心」的书页，就不会轻易逝去。", "author": "德谬歌", "from": "HSR" },
    { "value": "那些沉重的「记忆」，都将成为新世界萌芽的土壤。", "author": "德谬歌", "from": "HSR" },
    { "value": "只要能将一线希望，放进他的心里，他就一定能坚持下来。", "author": "德谬歌", "from": "HSR" },
    { "value": "收拾心绪，也是启程的一环呀。", "author": "德谬歌", "from": "HSR" },
    { "value": "故乡是很让人怀念，可更重要的，是迈出向前的脚步。", "author": "德谬歌", "from": "HSR" },
    { "value": "以爱为因，涤荡憎恨。以我为因，改写毁灭。", "author": "德谬歌", "from": "HSR" },
    { "value": "愿开拓之旅，永远有涟漪和清风相伴。", "author": "德谬歌", "from": "HSR" },
    { "value": "收下吧，我们的答案。", "author": "德谬歌", "from": "HSR" },
    { "value": "让刹那，成为永恒。", "author": "德谬歌", "from": "HSR" },
    { "value": "愿世界，如你我所愿", "author": "德谬歌", "from": "HSR" },
    { "value": "愿「浪漫」永不离席", "author": "德谬歌", "from": "HSR" },
    { "value": "愿「门径」再无别离", "author": "德谬歌", "from": "HSR" },
    { "value": "愿「纷争」加冕成王", "author": "德谬歌", "from": "HSR" },
    { "value": "愿「天空」治愈晨昏", "author": "德谬歌", "from": "HSR" },
    { "value": "愿「诡计」皆为游戏", "author": "德谬歌", "from": "HSR" },
    { "value": "愿「海洋」奏响欢宴", "author": "德谬歌", "from": "HSR" },
    { "value": "愿「律法」遍入群星", "author": "德谬歌", "from": "HSR" },
    { "value": "愿「岁月」守望长夜", "author": "德谬歌", "from": "HSR" },
    { "value": "愿「大地」捍卫前路", "author": "德谬歌", "from": "HSR" },
    { "value": "愿「生死」萌发新蕊", "author": "德谬歌", "from": "HSR" },
    { "value": "愿「理性」启蒙真理", "author": "德谬歌", "from": "HSR" },
    { "value": "愿「负世」照拂黎明", "author": "德谬歌", "from": "HSR" },
    { "value": "愿「开拓」，共赴「爱」的约定", "author": "德谬歌", "from": "HSR" },
    { "value": "亿万缕「记忆」——化作繁星照彻银河！", "author": "德谬歌", "from": "HSR" },
    { "value": "浪漫的结局——由每一颗心书写！", "author": "德谬歌", "from": "HSR" },
    { "value": "以「爱」汇成长河——席卷「恨」的坟茔！", "author": "德谬歌", "from": "HSR" },
    { "value": "一个人的性格，就是他的命运。", "author": "德谬歌", "from": "HSR" },
    { "value": "英雄只在最关键的时刻登场。", "author": "德谬歌", "from": "HSR" },
    { "value": "从今以后，世界不再需要神谕许诺的明天。", "author": "德谬歌", "from": "HSR" },
    { "value": "可若你睁开双眼，回望昨天，便能看见命运清澈的足迹。", "author": "德谬歌", "from": "HSR" },
    { "value": "逐火是从不断失却，走向坚定舍却的旅途。是知晓命运的破碎，仍以破碎拥抱命运，一段渴望被爱，更渴望去爱的旅途。", "author": "德谬歌", "from": "HSR" },
    { "value": "除非有人将「爱」栽种于心，带上它「开拓」前往「明天」。", "author": "德谬歌", "from": "HSR" },
    { "value": "在宇宙的「记忆」里，翁法罗斯将是一个辉煌、壮丽、英雄辈出的世界。", "author": "德谬歌", "from": "HSR" },
    { "value": "「毁灭」的阴影，由「记忆」来驱散。在「爱」的充盈下，挥洒光吧。", "author": "德谬歌", "from": "HSR" },
    { "value": "故事到来、逝去、去而复返。让我们重逢，又让我们分别。", "author": "德谬歌", "from": "HSR" },
    { "value": "最后，它留下一颗「种子」，一个理由。就算大树枯萎，万物沉寂……也有一些感情，依然值得被铭记。", "author": "德谬歌", "from": "HSR" },
    { "value": "希望文字像石子点水，自往昔投下，向未来送去涟漪。", "author": "德谬歌", "from": "HSR" },
    { "value": "在你写下的故事里，也许不可避免，仍有悲伤和注定落下的眼泪。", "author": "德谬歌", "from": "HSR" },
    { "value": "但，可以答应我吗？要永远做一朵温柔的花，在星星看向你的时候……只是笑着，只是爱着。就像花开花落，我讲述，你聆听。", "author": "德谬歌", "from": "HSR" },
    { "value": "我迎来自己的收梢，成为下一朵花绽放的养料。而你会启程，捧住那颗星星，在最后一页种下无垠的花海。而我们的故事，会静静地躺在花丛中，一如「记忆」的每一道涟漪。", "author": "德谬歌", "from": "HSR" },
    { "value": "也许我能创造奇迹，让黑潮在下一秒化作粉色的星海。也许…我只是一阵微不足道的涟漪，终将被「毁灭」吞没，什么也无法改变。", "author": "德谬歌", "from": "HSR" },
    { "value": "但无论如何，在这史诗的尾声，我不想再做沉默的听众，或是被供奉的神明。", "author": "德谬歌", "from": "HSR" },
    { "value": "要记得这个瞬间呀♪", "author": "德谬歌", "from": "HSR" },
    { "value": "喜欢这样悠闲的时光吗？我很喜欢哦，美好的一天，从见到你开始。", "author": "德谬歌", "from": "HSR" },
    { "value": "这朵花送给你！它就像少女的心房，要用心呵护哦。", "author": "德谬歌", "from": "HSR" },
    { "value": "把种子埋进土里，等待它发芽，开出软软的花，就像是在守候一个小小的奇迹。", "author": "德谬歌", "from": "HSR" },
    { "value": "坚定些，目光要一直看向前方呀。", "author": "德谬歌", "from": "HSR" },
    { "value": "风铃叮叮当当，就像是怦怦的心跳，好浪漫呀。", "author": "德谬歌", "from": "HSR" },
    { "value": "想听故事吗？我有好多好多，可以一个个讲给你听。条件只有一个——要仔细听，好吗？", "author": "德谬歌", "from": "HSR" },
    { "value": "「同一颗种子，在不同的土壤里，会开出相似而不同的花。但真正让她美丽的，是世界的每一颗心灵。」", "author": "德谬歌", "from": "HSR" },
    { "value": "无论哪种『喜欢』，都是弥足珍贵的『爱』，我都会感激地收下，幸福地回馈。", "author": "德谬歌", "from": "HSR" },
    { "value": "而在你的心里，我一定会得到最喜欢的，你给我的名字。毕竟，我们总是心有灵犀呀。", "author": "德谬歌", "from": "HSR" },
    { "value": "因果…真是无法被阻拦的力量呢。", "author": "德谬歌", "from": "HSR" },
    { "value": "但我记得你说过，当神明落下眼泪，倒映在涟漪里的，一定是最为美丽的事物。可是，你知道吗？当翁法罗斯的「心」诞生时，它最先看见的只是一个名字。", "author": "德谬歌", "from": "HSR" },
    { "value": "只要能将一线希望，放进他的心里……他就一定能坚持下来。", "author": "德谬歌", "from": "HSR" },
    { "value": "诚如神谕所示：「汝将肩负骄阳，直至灰白的黎明显著」。", "author": "德谬歌", "from": "HSR" },
    { "value": "我记得，哀丽秘榭的那棵树……它孤独地生长…哪里也去不了。它独自凝望着海面，想象着…永远到达不了的彼岸。不过，现在……有一叶小船…它载着从树上摘下的，愿望的种子…航向了远方。即便小船的影子，很快就会消失……但知晓自己的愿望，将在海的彼端…开花结果……那一刻的它…一定是幸福的吧？", "author": "德谬歌", "from": "HSR" },
    { "value": "循环往复，无穷的离别……也伴着，无穷的邂逅。", "author": "德谬歌", "from": "HSR" },
    { "value": "愿岁月的长河逆流而行，将未来的风景送至眼前。在那无人记得的永恒之地，「逐火之旅」「开拓」的神话将要开篇。", "author": "德谬歌", "from": "HSR" },
    { "value": "看……一切…已如我们…所书。", "author": "德谬歌", "from": "HSR" },
    { "value": "离别总是来得如此之快，愿我们都不会停下各自的脚步。", "author": "遐蝶", "from": "HSR" },
    { "value": "希望在人世的最后一刻，眼中所见并非无边的黑暗，而是宁静的花海。", "author": "遐蝶", "from": "HSR" },
    { "value": "我曾踽踽独行，就像落单的蝴蝶不知该往哪儿飞去，是伙伴与路人让我寻到了下一次振翅的方向。", "author": "遐蝶", "from": "HSR" },
    { "value": "“活着”从来不是一人的祈望，而是无数祝福的传递。", "author": "遐蝶", "from": "HSR" },
    { "value": "只有足够冰冷的手，才能握住滚烫的火种。", "author": "遐蝶", "from": "HSR" },
    { "value": "每个人都想破茧成蝶飞向广阔的天空，但总有人选择回到茧中，为了这世界的重新诞生。", "author": "遐蝶", "from": "HSR" },
    { "value": "失去越多的人，寻回一切的渴望便会越坚定。", "author": "遐蝶", "from": "HSR" },
    { "value": "纵然经历了生离死别，依然会为无法治愈的病痛落泪，但那眼泪绝不会带入病房，只留给世人永远明媚的阳光。", "author": "遐蝶", "from": "HSR" },
    { "value": "生命并非如蝶翼般易折，请珍惜灵魂还未枯萎的时光。", "author": "遐蝶", "from": "HSR" },
    { "value": "我更愿意把“死亡”视作宁静的告别，而非刑罚。", "author": "遐蝶", "from": "HSR" },
    { "value": "命运不是生长在道路尽头的花朵，而是人们自己踏出的小径。", "author": "遐蝶", "from": "HSR" },
    { "value": "征途之所以伟大，史诗之所以壮阔，是因为万物终有逝去之时。", "author": "遐蝶", "from": "HSR" },
    { "value": "即便“死亡”终将分离你我，也请让每一次相拥不留遗憾。", "author": "遐蝶", "from": "HSR" },
    { "value": "若心灵仍有余裕，请稍许分出些温柔，轻抚身边美好的一切。", "author": "遐蝶", "from": "HSR" },
    { "value": "时间的尽头，生命将点亮温暖的烛光，压倒“毁灭”的劫火。", "author": "遐蝶", "from": "HSR" },
    { "value": "冲破阴影后，便是黎明的轮廓。", "author": "遐蝶", "from": "HSR" },
    { "value": "比起犹豫，还是启程更好，也许就在今天，命运会恻恻一时，抛下些许仁慈。", "author": "遐蝶", "from": "HSR" },
    { "value": "这世上的离别皆是哀伤，但唯有直面它，才能捍卫你我珍视之物。", "author": "遐蝶", "from": "HSR" },
    { "value": "凡人的生与死本就不该被任何意志主宰，无人能独力担起生死的天平，哪怕是神明。", "author": "遐蝶", "from": "HSR" },
    { "value": "即便知晓命运的真容，生灵也毋须自轻，如人那般生，如人那般死。", "author": "遐蝶", "from": "HSR" },
    { "value": "西风的尽头星光照亮花海，前进吧，冰消雪释时花会盛开。", "author": "遐蝶", "from": "HSR" },
    { "value": "有一种温度足以跨越时间，哪怕此世未能相逢，也能在灵魂的深处产生共鸣。", "author": "遐蝶", "from": "HSR" },
    { "value": "点点滴滴的温暖都值得铭记在心，它们构成了我们对抗虚无的壁垒。", "author": "遐蝶", "from": "HSR" },
    { "value": "愿阁下的晖光，为灾厄中的众人带来希望，让徘徊的灵魂寻到各自的出路。", "author": "遐蝶", "from": "HSR" },
    { "value": "愿再见面时，我们都能成为彼此心中的英雄！", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "每个人心中都有一个英雄的模样，我们用岁月的刻刀一笔一划雕琢自己，直至「他」化为现实，成为手中最完美的作品。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "即便心有不安，我也相信漫漫长夜的尽头，是光的方向。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "痛苦而绝望的旅途，也是我唯一感到幸福的时刻！", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "恰恰是这颗看似空无一物的心，才装得下整个世界的心愿。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "死亡可以是温暖的，优美的，亲切的…那么，生命不更应如此么？", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "他永远能给人一种「无论发生什么，他都会与你站在一起」的信赖感。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "没关系。再难的事情，一步一步来总能解决。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "安宁平淡的日子，就像带着麦香的风。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "痛苦是有害的，苦难并不能使信仰变得高尚。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "这是天灾，但并非死劫。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "不辜负他们的信任，就是我等黄金裔的职责。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "坚持住！回想你的信仰，珍视的一切——如果做不到，就想象死亡吧，那反而能让你活下来！", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "决死时刻的眼神不会骗人，我能从他们的眼中找到信念，也愿意将后背交给他们。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "一个人道德的山尖，往往就是他对待朋友的方式。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "尤其在这动荡的时代，值得托付后背的同伴…弥足珍贵。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "就像眼前的道路，尽管残破不堪，但一定会通向终点。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "我的使命、意义…全都押在这里。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "你将在恐惧中抛却凡躯，然后自苦痛中重生为神。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "无妨。残酷的逐火已经让我抛弃了幻想，未来不可能是一片沐浴着西风的理想乡，静候着我们踏入其中……", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "如果等在前方的是一团混沌，那就由我将它撕裂……再引入第一缕烈阳的光芒。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "你这一路上已经创造了无数奇迹，对吧？", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "万世不息，永不动摇！", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "要背负创世的命运，我只需付出一样东西：毫无保留的深信。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "善意…是你们帮我滋养了它。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "自命不凡的英雄，与桀恶仅有一线之隔。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "凡人能够接受改变…人性值得被拯救！", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "这个在末世中砥砺奋进的族类，值得拥有第二次机会——我们配得上一个崭新的黎明！", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "行百里者半九十。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "历史从不会均匀地呼吸。它时而屏息千年，宛若时光停滞；时而急促地喘息，仿佛要在一瞬之间倾覆世界和文明。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "我感觉，自己不止能用剑锋斩除罪恶——还能以金焰创造黎明！", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "每一位没能走到最后的同伴，他们救世的信念都会成为我的一部分，拼凑出我一度丢失的灵魂。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "希望在那个新世界里，会有一轮崭新的朝阳升起——为所有人带去一个又一个黎明。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "平庸之人应当如此，方才能做出不平庸的选择。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "比世界的命运更为沉重之物，就是带着无法被改变的过往，背负它走向未来的决心。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "所谓的「英雄」，只是怀抱如此决心的一群人。而「救世主」——就是他们的总和，仅此而已。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "即便前方是漫漫长夜，我也相信…那是黎明的方向。在火光的尽头，是终将升起的烈阳。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "若我生来是「毁灭」的骄阳，便让你和你的走卒尽数作我爆发的耀斑！", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "铭记过去，成为明天的英雄吧。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "不必考量本心，不必渴求胜利。若我生来就是罪恶的容器……那就向着罪恶怒吼，为后世「开拓」黎明！", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "在不断失去的尽头，再度拾回一切！", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "每个人的心中都住着一个英雄。拥抱它，然后去追逐太阳吧。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "希望读到它的人，都能鼓起勇气面对燃烧的生命。", "author": "卡厄斯兰那", "from": "HSR" },
    { "value": "因为它不再纯粹。跌落也不是意外，是它向命运发起抗争，以破碎书写故事的结局。", "author": "德谬歌", "from": "HSR" },
    { "value": "我会许愿，从那伤口中流出的，不是鲜血，而是一滴湿润的眼泪。而它会落下，漾开最初的涟漪。那时人们会看见，倒映在涟漪中的，是一切美丽的事物。", "author": "德谬歌", "from": "HSR" },
    { "value": "可就算一切随风逝去，有些事也不会轻易改变。", "author": "德谬歌", "from": "HSR" },
    { "value": "水晶花之所以纯粹，是因为它封闭了自己，孤独绽放。才会在有缺的世界中格外耀眼。", "author": "德谬歌", "from": "HSR" },
    { "value": "同一颗种子，在不同的土壤里，会开出相似而不同的花。但真正让她美丽的，是世界的每一颗心灵。", "author": "德谬歌", "from": "HSR" },
    { "value": "所以，如果记忆中的风景模糊了，就伸手去触碰它。", "author": "德谬歌", "from": "HSR" },
    { "value": "就像每一个共读睡前故事的夜晚，抹去岁月的霜，擦亮回忆的轮廓，让它重新成为心灵的力量。", "author": "德谬歌", "from": "HSR" },
    { "value": "「记忆」就是这样的。在时间的长河里，它可能会磨损，会消散，但它不会离开。当内心的小角落被唤醒，回忆一定会以更美的形式再度浮现。", "author": "德谬歌", "from": "HSR" },
    { "value": "我听过这么一种说法：神性是「无瑕的人性」，而人性是「有瑕的神性」……", "author": "德谬歌", "from": "HSR" },
    { "value": "文字脱离了作者的手笔，被他人收入眼中的时候，它承载的意义就不受你我掌控啦。", "author": "德谬歌", "from": "HSR" },
    { "value": "在「智识」的实验里，在「毁灭」的温床中，它是熵增，是冰冷的真理，罪恶的本能……但在「记忆」和「开拓」笔下……", "author": "德谬歌", "from": "HSR" },
    { "value": "把解读的自由留给每一位翻开它的读者…不觉得这是件很浪漫的事吗？至于这段故事在你我眼中的意义，就让我们把它好好放在心底吧……", "author": "德谬歌", "from": "HSR" },
    { "value": "这世上没有任何一种语言，一行文字，能托得起这段旅途的重量。既然如此，就不必再囿于细微的字眼……", "author": "德谬歌", "from": "HSR" }
  ],
  "幽默解压": [
    { "value": "生活就像骑自行车，想保持平衡就得往前走，偶尔歪一下也没关系，反正风景不错。" },
    { "value": "今天的烦恼就留给今天，明天又是可以重新洗牌的一天。" },
    { "value": "别担心，你现在的努力，就像在存钱罐里投硬币，总有一天会“哗啦”一声掉出来。" },
    { "value": "人生没有白走的路，每一步都算数，哪怕是绕远路，也顺便看了风景。" },
    { "value": "压力大的时候，就把自己当成一块面团，揉一揉，摔一摔，最后总能变成好吃的馒头。" },
    { "value": "失败不是终点，而是成功在跟你玩捉迷藏，它只是暂时躲起来了。" },
    { "value": "别总盯着别人的进度条，你的时区里，一切都准时。" },
    { "value": "今天的你比昨天多懂了一点点，这就叫“微光”，攒多了就是太阳。" },
    { "value": "生活偶尔给你一颗柠檬，你就做个柠檬水，顺便加点糖，气死酸。" },
    { "value": "别怕慢，乌龟都能到终点，何况你还带了导航。" },
    { "value": "烦恼就像手机电量，充个电（睡一觉）就好了，别一直盯着“低电量”焦虑。" },
    { "value": "你不是在原地踏步，你是在给未来的自己攒经验值。" },
    { "value": "今天没做好？没关系，明天可以重开一局，人生又不是单机游戏，存档点很多。" },
    { "value": "别总想着“如果当初”，不如想想“幸好现在”。" },
    { "value": "压力是弹簧，你弱它就强，你笑它就软。" },
    { "value": "今天的你，已经比昨天多坚持了一秒，这就很酷。" },
    { "value": "生活就像拆盲盒，偶尔抽到“谢谢参与”，但下一个可能是“隐藏款惊喜”。" },
    { "value": "别怕犯错，错误是成功的“试错成本”，交完学费就该赚钱了。" },
    { "value": "你的努力，就像在沙漠里种树，现在看不见，但根已经在往下扎了。" },
    { "value": "今天的你，已经打败了99%的“想放弃”，剩下1%是“再试一次”。" },
    { "value": "别总盯着别人的高光，他们也在后台偷偷改bug。" },
    { "value": "生活给你一巴掌，你就跟它击个掌，说“谢了，刚好手痒”。" },
    { "value": "你不是不够好，你只是还在“加载中”，进度条99%了，别急。" },
    { "value": "今天的烦恼，就当成给大脑的“垃圾清理”，清完就轻松了。" },
    { "value": "别怕路长，走着走着，天就亮了，路也短了。" },
    { "value": "你的坚持，就像在存“勇气币”，攒够了就能兑换“梦想门票”。" },
    { "value": "生活偶尔卡顿，别慌，重启一下（睡一觉）就好了。" },
    { "value": "今天的你，已经比昨天多懂了一个道理，这就叫“成长税”，交得值。" },
    { "value": "别总想着“完美”，完美是“完成”的升级版，先完成，再完美。" },
    { "value": "压力大的时候，就把自己当成气球，放点气（深呼吸），别炸了。" },
    { "value": "你不是在原地打转，你是在给未来的自己画圆，圆画好了，路就通了。" },
    { "value": "今天的你，已经打败了“拖延症小怪兽”，奖励自己一颗糖。" },
    { "value": "生活给你一颗苦瓜，你就做个苦瓜酿肉，苦中带甜，才是人生。" },
    { "value": "别怕慢，蜗牛也能到金字塔顶，何况你还带了“坚持”牌滑板。" },
    { "value": "你的努力，就像在存“希望币”，攒够了就能兑换“未来快递”。" },
    { "value": "今天的烦恼，就当成给心灵的“大扫除”，扫完就亮堂了。" },
    { "value": "别总盯着别人的赛道，你的跑道，风景独好。" },
    { "value": "生活偶尔给你一颗柠檬，你就做个柠檬蛋糕，酸得可爱，甜得理直气壮。" },
    { "value": "你不是不够快，你只是在“蓄力”，像弓箭，拉得越满，射得越远。" },
    { "value": "今天的你，已经比昨天多坚持了一分钟，这就叫“微光”，攒多了就是灯塔。" },
    { "value": "别怕犯错，错误是成功的“预习”，预习完了，考试就不怕了。" },
    { "value": "生活给你一巴掌，你就跟它比个耶，说“谢了，刚好想拍照”。" },
    { "value": "今天的你，已经打败了“自我怀疑小怪兽”，奖励自己一个拥抱。" },
    { "value": "别总想着“如果当初”，不如想想“幸好现在”，现在就是最好的时候。" },
    { "value": "压力是弹簧，你笑它就软，你哭它就弹，不如笑着跟它玩。" },
    { "value": "你不是在原地踏步，你是在给未来的自己攒“经验值”，升级就在下一秒。" },
    { "value": "今天的烦恼，就当成给大脑的“缓存清理”，清完就流畅了。" },
    { "value": "别怕路长，走着走着，天就亮了，路也短了，风景还多了。" },
    { "value": "你的努力，就像在存“希望币”，攒够了就能兑换“未来快递”，包邮哦。" },
    { "value": "生活偶尔卡顿，别慌，重启一下（喝杯水）就好了，系统还在运行。" },
    { "value": "今天的你，已经比昨天多懂了一个道理，这就叫“成长税”，交得值，不亏。" },
    { "value": "别总想着“完美”，完美是“完成”的升级版，先完成，再完美，别卡bug。" },
    { "value": "压力大的时候，就把自己当成气球，放点气（深呼吸），别炸了，安全第一。" },
    { "value": "你不是在原地打转，你是在给未来的自己画圆，圆画好了，路就通了，还带光环。" },
    { "value": "今天的你，已经打败了“拖延症小怪兽”，奖励自己一颗糖，甜一下。" },
    { "value": "生活给你一颗苦瓜，你就做个苦瓜酿肉，苦中带甜，才是人生，还管饱。" },
    { "value": "别怕慢，蜗牛也能到金字塔顶，何况你还带了“坚持”牌滑板，嗖的一下。" },
    { "value": "你的努力，就像在存“勇气币”，攒够了就能兑换“梦想门票”，VIP座哦。" },
    { "value": "今天的烦恼，就当成给心灵的“大扫除”，扫完就亮堂了，还带香薰。" },
    { "value": "别总盯着别人的赛道，你的跑道，风景独好，还有专属BGM。" },
    { "value": "生活偶尔给你一颗柠檬，你就做个柠檬蛋糕，酸得可爱，甜得理直气壮，还带奶油。" },
    { "value": "你不是不够快，你只是在“蓄力”，像弓箭，拉得越满，射得越远，还带尾焰。" },
    { "value": "今天的你，已经比昨天多坚持了一分钟，这就叫“微光”，攒多了就是灯塔，还带导航。" },
    { "value": "别怕犯错，错误是成功的“预习”，预习完了，考试就不怕了，还带答案。" },
    { "value": "你的坚持，就像在存“希望币”，攒够了就能兑换“未来快递”，包邮，还带签收。" },
    { "value": "生活给你一巴掌，你就跟它比个耶，说“谢了，刚好想拍照”，还带滤镜。" },
    { "value": "今天的你，已经打败了“自我怀疑小怪兽”，奖励自己一个拥抱，还带暖宝宝。" },
    { "value": "别总想着“如果当初”，不如想想“幸好现在”，现在就是最好的时候，还带彩蛋。" },
    { "value": "压力是弹簧，你笑它就软，你哭它就弹，不如笑着跟它玩，还带掌声。" },
    { "value": "你不是在原地踏步，你是在给未来的自己攒“经验值”，升级就在下一秒，还带特效。" },
    { "value": "今天的烦恼，就当成给大脑的“缓存清理”，清完就流畅了，还带加速包。" },
    { "value": "别怕路长，走着走着，天就亮了，路也短了，风景还多了，还带解说。" },
    { "value": "你的努力，就像在存“希望币”，攒够了就能兑换“未来快递”，包邮，还带签收，好评返现。" },
    { "value": "生活偶尔卡顿，别慌，重启一下（喝杯水）就好了，系统还在运行，还带更新。" },
    { "value": "今天的你，已经比昨天多懂了一个道理，这就叫“成长税”，交得值，不亏，还带发票。" },
    { "value": "别总想着“完美”，完美是“完成”的升级版，先完成，再完美，别卡bug，还带补丁。" },
    { "value": "压力大的时候，就把自己当成气球，放点气（深呼吸），别炸了，安全第一，还带降落伞。" },
    { "value": "你不是在原地打转，你是在给未来的自己画圆，圆画好了，路就通了，还带光环，闪闪发光。" },
    { "value": "今天的你，已经打败了“拖延症小怪兽”，奖励自己一颗糖，甜一下，还带包装。" },
    { "value": "生活给你一颗苦瓜，你就做个苦瓜酿肉，苦中带甜，才是人生，还管饱，加量不加价。" },
    { "value": "别怕慢，蜗牛也能到金字塔顶，何况你还带了“坚持”牌滑板，嗖的一下，还带刹车。" },
    { "value": "你的努力，就像在存“勇气币”，攒够了就能兑换“梦想门票”，VIP座，还带爆米花。" },
    { "value": "今天的烦恼，就当成给心灵的“大扫除”，扫完就亮堂了，还带香薰，薰衣草味。" },
    { "value": "别总盯着别人的赛道，你的跑道，风景独好，还有专属BGM，还带应援棒。" },
    { "value": "生活偶尔给你一颗柠檬，你就做个柠檬蛋糕，酸得可爱，甜得理直气壮，还带奶油，双份。" },
    { "value": "你不是不够快，你只是在“蓄力”，像弓箭，拉得越满，射得越远，还带尾焰，超酷。" },
    { "value": "今天的你，已经比昨天多坚持了一分钟，这就叫“微光”，攒多了就是灯塔，还带导航，不迷路。" },
    { "value": "别怕犯错，错误是成功的“预习”，预习完了，考试就不怕了，还带答案，开卷。" },
    { "value": "你的坚持，就像在存“希望币”，攒够了就能兑换“未来快递”，包邮，还带签收，好评返现，五星。" },
    { "value": "生活给你一巴掌，你就跟它比个耶，说“谢了，刚好想拍照”，还带滤镜，美颜十级。" },
    { "value": "今天的你，已经打败了“自我怀疑小怪兽”，奖励自己一个拥抱，还带暖宝宝，发热款。" },
    { "value": "别总想着“如果当初”，不如想想“幸好现在”，现在就是最好的时候，还带彩蛋，惊喜。" },
    { "value": "压力是弹簧，你笑它就软，你哭它就弹，不如笑着跟它玩，还带掌声，全场最佳。" },
    { "value": "你不是在原地踏步，你是在给未来的自己攒“经验值”，升级就在下一秒，还带特效，满屏。" },
    { "value": "今天的烦恼，就当成给大脑的“缓存清理”，清完就流畅了，还带加速包，5G速度。" },
    { "value": "别怕路长，走着走着，天就亮了，路也短了，风景还多了，还带解说，专业版。" },
    { "value": "你的努力，就像在存“希望币”，攒够了就能兑换“未来快递”，包邮，还带签收，好评返现，下次还来。" },
    { "value": "生活偶尔卡顿，别慌，重启一下（喝杯水）就好了，系统还在运行，还带更新，新版本更流畅。" },
    { "value": "今天的你，已经比昨天多懂了一个道理，这就叫“成长税”，交得值，不亏，还带发票，可报销。" }
  ],
  "名人名言": [
    { "value": "知识就是力量。", "author": "培根", "from": "《新工具》" },
    { "value": "哲学家们只是用不同的方式解释世界，问题在于改变世界。", "author": "马克思", "from": "《关于费尔巴哈的提纲》" },
    { "value": "资本来到世间，从头到脚，每个毛孔都滴着血和肮脏的东西。", "author": "马克思", "from": "《资本论》" },
    { "value": "人们自己创造自己的历史，但是他们并不是随心所欲地创造。", "author": "马克思", "from": "《路易·波拿巴的雾月十八日》" },
    { "value": "全世界无产者，联合起来！", "author": "马克思、恩格斯", "from": "《共产党宣言》" },
    { "value": "星星之火，可以燎原。", "author": "毛泽东", "from": "《星星之火，可以燎原》" },
    { "value": "没有调查，就没有发言权。", "author": "毛泽东", "from": "《反对本本主义》" },
    { "value": "自信人生二百年，会当水击三千里。", "author": "毛泽东" },
    { "value": "哪里有压迫，哪里就有反抗。", "author": "毛泽东", "from": "《湖南农民运动考察报告》" },
    { "value": "一切反动派都是纸老虎。", "author": "毛泽东", "from": "《和美国记者安娜·路易斯·斯特朗的谈话》" },
    { "value": "我们的同志在困难的时候，要看到成绩，要看到光明，要提高我们的勇气。", "author": "毛泽东", "from": "《为人民服务》" },
    { "value": "对于马克思主义的理论，要能够精通它、应用它，精通的目的全在于应用。", "author": "毛泽东", "from": "《整顿党的作风》" },
    { "value": "凡是反动的东西，你不打，他就不倒。", "author": "毛泽东", "from": "《抗日战争胜利后的时局和我们的方针》" },
    { "value": "人总是要有点精神的。", "author": "毛泽东" },
    { "value": "世界是你们的，也是我们的，但是归根结底是你们的。", "author": "毛泽东", "from": "莫斯科讲话" },
    { "value": "真理往往掌握在少数人手里。", "author": "列宁" },
    { "value": "忘记过去就意味着背叛。", "author": "列宁" },
    { "value": "学习，学习，再学习。", "author": "列宁" },
    { "value": "谁是我们的敌人？谁是我们的朋友？这个问题是革命的首要问题。", "author": "毛泽东", "from": "《中国社会各阶级的分析》" },
    { "value": "政策是革命政党一切实际行动的出发点，并且表现于行动的过程和归宿。", "author": "毛泽东" },
    { "value": "世界上怕就怕“认真”二字，共产党就最讲认真。", "author": "毛泽东" },
    { "value": "其实地上本没有路，走的人多了，也便成了路。", "author": "鲁迅", "from": "《故乡》" },
    { "value": "真的猛士，敢于直面惨淡的人生，敢于正视淋漓的鲜血。", "author": "鲁迅", "from": "《记念刘和珍君》" },
    { "value": "横眉冷对千夫指，俯首甘为孺子牛。", "author": "鲁迅", "from": "《自嘲》" },
    { "value": "不在沉默中爆发，就在沉默中灭亡。", "author": "鲁迅", "from": "《记念刘和珍君》" },
    { "value": "愿中国青年都摆脱冷气，只是向上走，不必听自暴自弃者流的话。", "author": "鲁迅", "from": "《热风》" },
    { "value": "人类的悲欢并不相通，我只觉得他们吵闹。", "author": "鲁迅", "from": "《小杂感》" },
    { "value": "人生最苦痛的是梦醒了无路可以走。", "author": "鲁迅", "from": "《娜拉走后怎样》" },
    { "value": "爱看书的青年，大可以看看本分以外的书，即课外的书，不要只将课内的书抱住。", "author": "鲁迅" },
    { "value": "说真话，面对现实，这才是作家的良心。", "author": "巴金" },
    { "value": "理想不抛弃苦心追求的人，只要不停止追求，你们会沐浴在理想的光辉之中。", "author": "巴金" },
    { "value": "生活就是战斗。", "author": "巴金" },
    { "value": "雨下给富人，也下给穷人；下给义人，也下给不义的人。其实，雨并不公道，因为下落在一个没有公道的世界上。", "author": "老舍", "from": "《骆驼祥子》" },
    { "value": "才华是刀刃，辛苦是磨刀石，再锋利的刀刃，若日久不用石磨，也会生锈。", "author": "老舍" },
    { "value": "人，即使活到八九十岁，有母亲便可以多少还有点孩子气。", "author": "老舍", "from": "《我的母亲》" },
    { "value": "生命是一袭华美的袍，爬满了蚤子。", "author": "张爱玲", "from": "《天才梦》" },
    { "value": "因为爱过，所以慈悲；因为懂得，所以宽容。", "author": "张爱玲" },
    { "value": "我们生在这世上，多半是为了吃苦的。", "author": "钱钟书", "from": "《围城》" },
    { "value": "婚姻是一座围城，城外的人想进去，城里的人想出来。", "author": "钱钟书", "from": "《围城》" },
    { "value": "天下就没有偶然，那不过是化了妆、戴了面具的必然。", "author": "钱钟书", "from": "《围城》" },
    { "value": "一个人至少拥有一个梦想，有一个理由去坚强。", "author": "三毛" },
    { "value": "幸福的家庭都是相似的，不幸的家庭各有各的不幸。", "author": "托尔斯泰", "from": "《安娜·卡列尼娜》" },
    { "value": "人是为了活着本身而活着，而不是为了活着之外的任何事物而活着。", "author": "余华", "from": "《活着》" },
    { "value": "凡是有钱的单身汉，总想娶位太太，这已经成了一条举世公认的真理。", "author": "简·奥斯汀", "from": "《傲慢与偏见》" },
    { "value": "生存还是毁灭，这是一个值得考虑的问题。", "author": "莎士比亚", "from": "《哈姆雷特》" },
    { "value": "世界上只有一种真正的英雄主义，那就是在认清生活的真相后依然热爱生活。", "author": "罗曼·罗兰", "from": "《米开朗基罗传》" },
    { "value": "人可以被毁灭，但不能被打败。", "author": "海明威", "from": "《老人与海》" },
    { "value": "所有动物一律平等，但有些动物比其他动物更平等。", "author": "奥威尔", "from": "《动物农场》" },
    { "value": "这是最好的时代，这是最坏的时代。", "author": "狄更斯", "from": "《双城记》" },
    { "value": "我越是孤独，越是没有朋友，越是没有支持，我就得越尊重我自己。", "author": "夏洛蒂·勃朗特", "from": "《简·爱》" },
    { "value": "无论走到哪里，都应该记住，过去都是假的，回忆是一条没有归途的路。", "author": "马尔克斯", "from": "《百年孤独》" },
    { "value": "生命中曾经有过的所有灿烂，终究都需要用寂寞来偿还。", "author": "马尔克斯", "from": "《百年孤独》" },
    { "value": "一个人并不是生来要给打败的，你尽可以把他消灭掉，可就是打不败他。", "author": "海明威", "from": "《老人与海》" },
    { "value": "我们都在阴沟里，但仍有人仰望星空。", "author": "王尔德", "from": "《温德米尔夫人的扇子》" },
    { "value": "善良是一种世界通用的语言，它可以使盲人感到，聋子闻到。", "author": "马克·吐温" },
    { "value": "每当你发现自己站在多数人一边时，就该停下来反思了。", "author": "马克·吐温" },
    { "value": "人生而自由，却无往不在枷锁之中。", "author": "卢梭", "from": "《社会契约论》" },
    { "value": "他人即地狱。", "author": "萨特", "from": "《禁闭》" },
    { "value": "存在先于本质。", "author": "萨特", "from": "《存在主义是一种人道主义》" },
    { "value": "未经审视的人生是不值得过的。", "author": "苏格拉底" },
    { "value": "我思故我在。", "author": "笛卡尔" },
    { "value": "人是万物的尺度。", "author": "普罗泰戈拉" },
    { "value": "想象力比知识更重要。", "author": "爱因斯坦" },
    { "value": "只有两样东西是无限的：宇宙和人类的愚蠢，而对于宇宙是否无限，我还不太确定。", "author": "爱因斯坦" },
    { "value": "那些杀不死我的，终将使我更强大。", "author": "尼采", "from": "《偶像的黄昏》" },
    { "value": "每一个不曾起舞的日子，都是对生命的辜负。", "author": "尼采", "from": "《查拉图斯特拉如是说》" },
    { "value": "当你凝视深渊时，深渊也在凝视着你。", "author": "尼采", "from": "《善恶的彼岸》" },
    { "value": "人生如同故事，重要的并不在于有多长，而是在于有多好。", "author": "塞涅卡" },
    { "value": "书籍是人类进步的阶梯。", "author": "高尔基" },
    { "value": "苦难是人生的老师。", "author": "巴尔扎克" },
    { "value": "如果我看得比别人更远些，那是因为我站在巨人的肩膀上。", "author": "牛顿" },
    { "value": "天才是百分之一的灵感加上百分之九十九的汗水。", "author": "爱迪生" },
    { "value": "保持饥饿，保持愚蠢。", "author": "史蒂夫·乔布斯", "from": "《全球概览》" },
    { "value": "创新就是把各种事物整合到一起。", "author": "乔布斯" },
    { "value": "你的时间有限，不要浪费在过别人的生活上。", "author": "乔布斯" },
    { "value": "悲观者正确，乐观者成功。", "author": "纳瓦尔" },
    { "value": "种一棵树最好的时间是十年前，其次是现在。", "author": "丹比萨·莫约" },
    { "value": "教育的本质意味着：一棵树摇动另一棵树，一朵云推动另一朵云，一个灵魂唤醒另一个灵魂。", "author": "雅斯贝尔斯" },
    { "value": "所谓活着的人，就是不断挑战的人，不断攀登命运高峰的人。", "author": "雨果" },
    { "value": "真正的智慧是知道自己无知。", "author": "苏格拉底" },
    { "value": "习惯形成性格，性格决定命运。", "author": "约·凯恩斯" },
    { "value": "读一本好书，就是和一个高尚的人谈话。", "author": "歌德" },
    { "value": "你若要喜爱你自己的价值，你就得给世界创造价值。", "author": "歌德" },
    { "value": "浪费时间是一桩大罪过。", "author": "卢梭" },
    { "value": "最可怕的敌人，就是没有坚强的信念。", "author": "罗曼·罗兰" },
    { "value": "宿命论是那些缺乏意志力的弱者的借口。", "author": "罗曼·罗兰" },
    { "value": "伟大的事业是根源于坚韧不断的工作，以全副的精神去从事，不避艰苦。", "author": "罗素" },
    { "value": "参差多态乃是幸福的本源。", "author": "罗素" },
    { "value": "我对人类的爱，不是因为他们完美，而是因为他们真实。", "author": "弗洛姆" },
    { "value": "爱不是占有，也不是被占有，爱只在爱中满足。", "author": "纪伯伦", "from": "《先知》" },
    { "value": "你的心灵常常是战场，在这个战场上，你的理性与判断和你的热情与嗜欲开战。", "author": "纪伯伦" },
    { "value": "除了通过黑夜的道路，人们不能到达黎明。", "author": "纪伯伦" },
    { "value": "一个人思虑太多，就会失去做人的乐趣。", "author": "莎士比亚" },
    { "value": "闪光的东西，并不都是金子；动听的语言，并不都是好话。", "author": "莎士比亚" },
    { "value": "逆境是通往真理的第一条道路。", "author": "拜伦" },
    { "value": "如果冬天来了，春天还会远吗？", "author": "雪莱", "from": "《西风颂》" },
    { "value": "美是真理的微笑，当她认识到自己的时候。", "author": "泰戈尔" },
    { "value": "世界以痛吻我，要我报之以歌。", "author": "泰戈尔", "from": "《飞鸟集》" },
    { "value": "鸟翼上系上了黄金，这鸟便永不能再在天上翱翔了。", "author": "泰戈尔" },
    { "value": "让死者有那不朽的名，但让生者有那不朽的爱。", "author": "泰戈尔" },
    { "value": "未被表达的情绪永远都不会消失。它们只是被活埋了，有朝一日会以更丑恶的方式爆发出来。", "author": "弗洛伊德" },
    { "value": "梦是通往潜意识的皇家大道。", "author": "弗洛伊德", "from": "《梦的解析》" },
    { "value": "人的自我就像地球一样，我们对自己了解的部分，远不如我们不了解的部分多。", "author": "弗洛伊德" },
    { "value": "往外张望的人在做梦，向内审视的人才是清醒的。", "author": "荣格" },
    { "value": "你连想改变别人的念头都不要有。要学习太阳一样，只是发出光和热。", "author": "荣格" },
    { "value": "孤独并不是来自身边无人，而是感到自己无法与他人交流最要紧的感受。", "author": "荣格" },
    { "value": "谁控制了过去，谁就控制了未来；谁控制了现在，谁就控制了过去。", "author": "奥威尔", "from": "《1984》" },
    { "value": "战争即和平，自由即奴役，无知即力量。", "author": "奥威尔", "from": "《1984》" },
    { "value": "在人类历史上，只有当他们知道自己有所作为时，他们才会采取行动。", "author": "加缪", "from": "《西西弗神话》" },
    { "value": "人是唯一拒绝成为动物的生物。", "author": "加缪" },
    { "value": "我们很少信任比我们好的人，宁肯避免与他们来往。相反，我们常对与我们相似、和我们有着共同弱点的人吐露心迹。", "author": "加缪" },
    { "value": "在绝对正确的善良之上，还有一个绝对正确的人道主义。", "author": "雨果", "from": "《九三年》" },
    { "value": "世界上最宽阔的是海洋，比海洋更宽阔的是天空，比天空更宽阔的是人的胸怀。", "author": "雨果", "from": "《悲惨世界》" },
    { "value": "只要有个女人像男人一样思考，她就一定会被男人讨厌。", "author": "波伏娃", "from": "《第二性》" },
    { "value": "女人不是天生的，而是后天形成的。", "author": "波伏娃", "from": "《第二性》" },
    { "value": "权力以知识为基础，知识以权力为基础。", "author": "福柯" },
    { "value": "哪里有权力，哪里就有抵抗。", "author": "福柯" },
    { "value": "人是悬挂在由他自己编织的意义之网上的动物。", "author": "马克斯·韦伯" },
    { "value": "现代社会的悲剧在于：它许诺了自由，却只提供了孤独。", "author": "弗洛姆", "from": "《逃避自由》" },
    { "value": "爱主要是给予，而不是接受。", "author": "弗洛姆", "from": "《爱的艺术》" },
    { "value": "人的一切痛苦，本质上都是对自己无能的愤怒。", "author": "王小波" },
    { "value": "活下去的诀窍是：保持愚蠢，又不能知道自己有多蠢。", "author": "王小波" },
    { "value": "我活在世上，无非想要明白些道理，遇见些有趣的事。", "author": "王小波" },
    { "value": "一个人只拥有此生此世是不够的，他还应该拥有诗意的世界。", "author": "王小波" },
    { "value": "命运中有一种错误是只能犯一次的，并没有改正的机会。", "author": "史铁生", "from": "《命若琴弦》" },
    { "value": "且视他人之疑目如盏盏鬼火，大胆地去走你的夜路。", "author": "史铁生" },
    { "value": "我常以为是丑女造就了美人，我常以为是愚氓举出了智者，我常以为是懦夫衬照了英雄。", "author": "史铁生", "from": "《我与地坛》" },
    { "value": "且视夜为昼，且视死为生。", "author": "史铁生" },
    { "value": "真正的成熟，是你在经历过太多事情后，依然能够将内心与这个世界进行和解。", "author": "陈丹青" },
    { "value": "我们不仅要活得长久，还要活得有质量。", "author": "陈丹青" },
    { "value": "所谓无底深渊，下去，也是前程万里。", "author": "木心", "from": "《素履之往》" },
    { "value": "岁月不饶人，我亦未曾饶过岁月。", "author": "木心" },
    { "value": "生活的最好状态是冷冷清清的风风火火。", "author": "木心" },
    { "value": "从前的日色变得慢，车，马，邮件都慢，一生只够爱一个人。", "author": "木心", "from": "《从前慢》" },
    { "value": "人生最曼妙的风景，竟是内心的淡定与从容。", "author": "杨绛" },
    { "value": "我们曾如此渴望命运的波澜，到最后才发现：人生最曼妙的风景，竟是内心的淡定与从容。", "author": "杨绛", "from": "《一百岁感言》" },
    { "value": "唯有身处卑微的人，最有机缘看到世态人情的真相。", "author": "杨绛" },
    { "value": "读书好比串门儿——隐身的串门儿。", "author": "杨绛" },
    { "value": "一个人不想攀高就不怕下跌，也不用倾轧排挤，可以保其天真，成其自然。", "author": "杨绛" },
    { "value": "我们要有最朴素的生活，与最遥远的梦想。", "author": "七堇年" },
    { "value": "我们生活在一个恶的时代。现在没有一样东西是名正言顺的。", "author": "卡夫卡" },
    { "value": "目标虽有，却无路可走；我谓之路，但那只是在彷徨。", "author": "卡夫卡" },
    { "value": "一只鸟出生时，蛋就是它的全世界。", "author": "卡夫卡" },
    { "value": "人只有在不得不做某事时，才会真正去做。", "author": "卡夫卡" },
    { "value": "我要扼住命运的咽喉，它决不能使我完全屈服。", "author": "贝多芬" },
    { "value": "真正的才华如火焰般难以收藏，总会燎原。", "author": "夏洛蒂·勃朗特" },
    { "value": "凡是想获得幸福的人，都应该先学会忍受痛苦。", "author": "陀思妥耶夫斯基" },
    { "value": "我只害怕一件事情：我怕我配不上自己所受的苦难。", "author": "陀思妥耶夫斯基" },
    { "value": "一个人知道自己为什么而活，就可以忍受任何一种生活。", "author": "尼采" },
    { "value": "过去都是假的，回忆是一条没有归途的路。", "author": "马尔克斯", "from": "《百年孤独》" },
    { "value": "无论走到哪里，都应该记住，过去都是假的，回忆没有归路。", "author": "马尔克斯", "from": "《百年孤独》" },
    { "value": "人生不是一支短短的蜡烛，而是一只由我们暂时拿着的火炬。", "author": "萧伯纳" },
    { "value": "历史波澜壮阔，镌刻下青年的名字；未来长空万里，期待着青年的进发。", "from": "《人民日报》" },
    { "value": "孤臣霜发三千丈，每岁烟花一万重。", "author": "陈与义" },
    { "value": "愿将腰下剑，直为斩楼兰。", "author": "李白" },
    { "value": "还历史以真实，还生命以过程。", "author": "余秋雨" },
    { "value": "我一定要去寻找，就算无尽的星辰令我的探寻希望渺茫，就算我必须单枪匹马。", "author": "阿西莫夫" },
    { "value": "今天在惊恐的深渊之中，我也会一而再地抬头仰望那些旧日的星辰。", "author": "茨威格" },
    { "value": "在我的生命中，也有让我不恋生之乐、亦不惧死之哀的使命。", "author": "杜富国" },
    { "value": "所谓成功，就是用自己喜欢的方式度过人生。", "author": "当年明月", "from": "《明朝那些事儿》" },
    { "value": "有时候，屈辱地活着比悲壮地死去更需要勇气。", "author": "当年明月", "from": "《明朝那些事儿》" },
    { "value": "给岁月以文明，而不是给文明以岁月。", "author": "刘慈欣", "from": "《三体》" },
    { "value": "弱小和无知，都不是生存的障碍，傲慢才是。", "author": "刘慈欣", "from": "《三体》" },
    { "value": "你的无畏来源于无知。", "author": "刘慈欣", "from": "《三体》" },
    { "value": "失去人性，失去很多；失去兽性，失去一切。", "author": "刘慈欣", "from": "《三体》" },
    { "value": "宇宙很大，生活更大。", "author": "刘慈欣", "from": "《三体》" },
    { "value": "做人不能忘记四条：话不要说错，床不要睡错，门槛不要踏错，口袋不要摸错。", "author": "余华", "from": "《活着》" },
    { "value": "只要一家人天天在一起，也就不在乎什么福分了。", "author": "余华", "from": "《活着》" },
    { "value": "读书原为修身，正己才能正人正事。", "author": "陈忠实", "from": "《白鹿原》" },
    { "value": "好饭耐不得三顿吃，好衣架不住半月穿，好书却经得住一辈子读。", "author": "陈忠实", "from": "《白鹿原》" },
    { "value": "人生海海，敢死不叫勇气，活着才需要勇气。", "author": "麦家", "from": "《人生海海》" },
    { "value": "世上只有一种英雄主义，就是在认清生活真相之后依然热爱生活。", "author": "麦家、罗曼·罗兰", "from": "《人生海海》《米开朗基罗传》" },
    { "value": "毫不费力就到嘴的食物，不是毒药，就是诱饵。", "author": "姜戎", "from": "《狼图腾》" },
    { "value": "一百次心动不如一次行动。", "author": "姜戎", "from": "《狼图腾》" },
    { "value": "我们这个家，很朴素；我们三个人，很单纯。", "author": "杨绛", "from": "《我们仨》" },
    { "value": "世间好物不坚牢，彩云易散琉璃脆。", "author": "杨绛", "from": "《我们仨》" },
    { "value": "走在活着的路上，不知道命运是什么，才知道什么是命运。", "author": "史铁生", "from": "《总有路在等你》" },
    { "value": "一定要爱着点什么，恰似草木对光阴的钟情。", "author": "史铁生", "from": "《总有路在等你》" },
    { "value": "太阳，它每时每刻都是夕阳也都是旭日。", "author": "史铁生" },
    { "value": "孤独，不是在空茫而寒冷的大海上只身漂流，而是在人群密集的地方，在美好生活展开的地方，没有你的位置。", "author": "史铁生", "from": "《务虚笔记》" },
    { "value": "理论只要说服人，就能掌握群众；而理论只要彻底，就能说服人。", "author": "马克思", "from": "《<黑格尔法哲学批判>导言》" },
    { "value": "在科学上没有平坦的大道，只有不畏劳苦沿着陡峭山路攀登的人，才有希望达到光辉的顶点。", "author": "马克思", "from": "《资本论》" },
    { "value": "群众是真正的英雄，而我们自己则往往是幼稚可笑的。", "author": "毛泽东", "from": "《<农村调查>的序言和跋》" },
    { "value": "我们共产党人好比种子，人民好比土地。", "author": "毛泽东", "from": "《关于重庆谈判》" },
    { "value": "下定决心，不怕牺牲，排除万难，去争取胜利。", "author": "毛泽东", "from": "《愚公移山》" },
    { "value": "夺取全国胜利，这只是万里长征走完了第一步。", "author": "毛泽东", "from": "《在中国共产党第七届中央委员会第二次全体会议上的报告》" },
    { "value": "外因是变化的条件，内因是变化的根据，外因通过内因而起作用。", "author": "毛泽东", "from": "《矛盾论》" },
    { "value": "一个人能力有大小，但只要有这点精神，就是一个高尚的人，一个纯粹的人，一个有道德的人，一个脱离了低级趣味的人，一个有益于人民的人。", "author": "毛泽东", "from": "《纪念白求恩》" },
    { "value": "虚心使人进步，骄傲使人落后。", "author": "毛泽东", "from": "《中国共产党第八次全国代表大会开幕词》" },
    { "value": "世上无难事，只要肯登攀。", "author": "毛泽东", "from": "《水调歌头·重上井冈山》" },
    { "value": "饭可以一日不吃，觉可以一日不睡，书不可以一日不读。", "author": "毛泽东" },
    { "value": "孩儿立志出乡关，学不成名誓不还。埋骨何须桑梓地，人生无处不青山。", "author": "毛泽东", "from": "《七绝·改西乡隆盛诗赠父亲》" },
    { "value": "敌进我退，敌驻我扰，敌疲我打，敌退我追。", "author": "毛泽东", "from": "《游击战十六字诀》" },
    { "value": "所谓的自由，就是被别人讨厌。", "author": "岸见一郎", "from": "《被讨厌的勇气》" },
    { "value": "健全的自卑感不是来自与别人的比较，而是来自与“理想的自己”比较。", "author": "岸见一郎", "from": "《被讨厌的勇气》" },
    { "value": "把一件事情做到极致，本身就是一种自由。", "author": "阿城", "from": "《棋王》" },
    { "value": "人间有味是清欢。", "author": "汪曾祺", "from": "《受戒》" },
    { "value": "为你，千千万万遍。", "author": "卡勒德·胡赛尼", "from": "《追风筝的人》" },
    { "value": "许多年过去了，人们说陈年旧事可以被埋葬，然而我终于明白这是错的，因为往事会自行爬上来。", "author": "卡勒德·胡赛尼", "from": "《追风筝的人》" },
    { "value": "人性之初，荫于谎言。", "author": "芥川龙之介", "from": "《罗生门》" },
    { "value": "充满了可耻的一生。", "author": "太宰治", "from": "《人间失格》" },
    { "value": "弱小和无知不是生存的障碍，傲慢才是。", "author": "刘慈欣", "from": "《三体Ⅱ·黑暗森林》" },
    { "value": "我们都是阴沟里的虫子，但总还是得有人仰望星空。", "author": "刘慈欣", "from": "《三体Ⅰ》" },
    { "value": "毁灭你，与你何干？", "author": "刘慈欣", "from": "《三体Ⅲ·死神永生》" },
    { "value": "宇宙就是一座黑暗森林，每个文明都是带枪的猎人。", "author": "刘慈欣", "from": "《三体Ⅱ·黑暗森林》" },
    { "value": "前进！前进！不择手段地前进！", "author": "刘慈欣", "from": "《三体Ⅲ·死神永生》" },
    { "value": "不要回答！不要回答！不要回答！", "author": "刘慈欣", "from": "《三体Ⅰ》" },
    { "value": "死亡是一座永恒的灯塔，不管你驶向何方，最终都会朝它转。一切都将逝去，只有死神永生。", "author": "刘慈欣", "from": "《三体Ⅲ·死神永生》" },
    { "value": "藏好自己，做好清理。", "author": "刘慈欣", "from": "《三体Ⅲ·死神永生》" },
    { "value": "光锥之内就是命运。", "author": "刘慈欣", "from": "《三体Ⅱ·黑暗森林》" },
    { "value": "把人类看成虫子的三体人似乎忘记了一个事实：虫子从来就没有被战胜过。", "author": "刘慈欣", "from": "《三体Ⅰ》" },
    { "value": "没有救世的能力不是你的错，但给世界以希望后又打碎它，就是一种不可饶恕的罪恶了。", "author": "刘慈欣", "from": "《三体Ⅲ·死神永生》" },
    { "value": "唯一不可阻挡的是时间，它像一把利刃，无声地切开了坚硬和柔软的一切。", "author": "刘慈欣", "from": "《三体Ⅱ·黑暗森林》" },
    { "value": "记忆是一条早已干涸的河流，只在毫无生气的河床中剩下零落的砾石。", "author": "刘慈欣", "from": "《三体Ⅱ·黑暗森林》" },
    { "value": "在中国，任何超脱飞扬的思想都会砰然坠地，因为现实的引力太沉重了。", "author": "刘慈欣", "from": "《三体Ⅰ》" },
    { "value": "空不是无，空是一种存在，你得用空这种存在填满自己。", "author": "刘慈欣", "from": "《三体Ⅰ》" },
    { "value": "越透明的东西越神秘，宇宙本身就是透明的，只要目力能及，你想看多远就看多远，但越看越神秘。", "author": "刘慈欣", "from": "《三体Ⅰ》" },
    { "value": "活着本身就很妙，如果连这道理都不懂，怎么去探索更深的东西呢？", "author": "刘慈欣", "from": "《三体Ⅰ》" },
    { "value": "过去就像攥在手中的一把干沙，自以为攥得很紧，其实早就从指缝中流光了。", "author": "刘慈欣", "from": "《三体Ⅰ》" },
    { "value": "在意义之塔上，生存高于一切，面对生存，任何低熵体都只能两害相权取其轻。", "author": "刘慈欣", "from": "《三体Ⅱ·黑暗森林》" },
    { "value": "把海弄干的鱼在海干前上了陆地，从一片黑暗森林奔向另一片黑暗森林。鱼上了岸，也就不再是鱼。", "author": "刘慈欣", "from": "《三体Ⅲ·死神永生》" },
    { "value": "碑是那么小，与其说是为了纪念，更像是为了忘却。", "author": "刘慈欣", "from": "《三体Ⅱ·黑暗森林》" },
    { "value": "大多数人到死都没有向尘世之外瞥一眼。", "author": "刘慈欣", "from": "《三体Ⅰ》" },
    { "value": "在这寒冷无际的草原间，燃烧是无意义的，一腔热血喷出来，比一堆牛粪凉的更快，还不如后者有实用价值。但燃烧是他们的命运，他们是燃烧的一代。", "author": "刘慈欣", "from": "《三体Ⅰ》" },
    { "value": "既没有入世的能力也没有出世的资本。", "author": "刘慈欣", "from": "《三体Ⅲ·死神永生》" },
    { "value": "只有那些疯狂到以为自己能够改变世界的人，才能真正改变世界。", "author": "史蒂夫·乔布斯" },
    { "value": "如果你把每一天都当作生命中最后一天去生活，那么总有一天你会发现自己是正确的。", "author": "史蒂夫·乔布斯" },
    { "value": "你的工作将占据你很大一部分生活，你唯一能够真正感到满足的方法，就是去做你认为是伟大的工作。", "author": "史蒂夫·乔布斯" },
    { "value": "成功是一个糟糕的老师，它诱使聪明人认为自己不会失败。", "author": "比尔·盖茨" },
    { "value": "不要拿自己与世界上的任何人比。如果你这么做，你就是在侮辱自己。", "author": "比尔·盖茨" },
    { "value": "我并非生来富有，但我生来就注定要变得富有。", "author": "伯纳德·阿尔诺" },
    { "value": "如果你没有建立自己的商业帝国，你就会被别人雇佣去建立他们的帝国。", "author": "佚名", "from": "商业格言" },
    { "value": "利润只是结果，不是目的。", "author": "稻盛和夫" },
    { "value": "在商业中，没有永远的赢家，只有不断适应变化的人。", "author": "杰克·韦尔奇" },
    { "value": "创新不是对老产品的修修补补，而是创造一种全新的价值。", "author": "彼得·德鲁克" },
    { "value": "预测未来最好的方法，就是去创造未来。", "author": "彼得·德鲁克" },
    { "value": "管理是把事情做对，领导是做对的事情。", "author": "彼得·德鲁克" },
    { "value": "企业的唯一目的就是创造顾客。", "author": "彼得·德鲁克" },
    { "value": "我们不是因为有钱才做慈善，而是因为我们做对了事情才变得有钱。", "author": "马云" },
    { "value": "永远把别人对你的批评记在心里，别人的表扬就把它忘了。", "author": "马云" },
    { "value": "今天很残酷，明天更残酷，后天很美好，但绝大多数人死在明天晚上。", "author": "马云" },
    { "value": "如果你不想做，就找一个借口；如果你想做，就找一个方法。", "author": "吉姆·罗恩" },
    { "value": "成功就是每天进步一点点。", "author": "吉姆·罗恩" },
    { "value": "你的收入是你身边五个朋友的平均值。", "author": "吉姆·罗恩" },
    { "value": "永远不要低估一个傻瓜的破坏力。", "author": "沃伦·巴菲特" },
    { "value": "别人贪婪时我恐惧，别人恐惧时我贪婪。", "author": "沃伦·巴菲特" },
    { "value": "价格是你支付的，价值是你得到的。", "author": "沃伦·巴菲特" },
    { "value": "投资最重要的规则：第一条，永远不要亏钱；第二条，永远不要忘记第一条。", "author": "沃伦·巴菲特" },
    { "value": "风险来自于你不知道自己在做什么。", "author": "沃伦·巴菲特" },
    { "value": "如果你不愿意拥有一只股票十年，那就连十分钟也不要拥有。", "author": "沃伦·巴菲特" },
    { "value": "真正的发现之旅不在于寻找新的风景，而在于拥有新的眼睛。", "author": "马塞尔·普鲁斯特" },
    { "value": "我们花了一生时间，才学会如何生活，却常常忘记如何去爱。", "author": "佚名" },
    { "value": "人生没有彩排，每一天都是现场直播。", "author": "佚名" },
    { "value": "真正的自由不是你想做什么就做什么，而是你不想做什么就可以不做什么。", "author": "康德" },
    { "value": "所谓成熟，就是知道有些事情终究无能为力。", "author": "塞林格" },
    { "value": "我们终此一生，就是要摆脱他人的期待，找到真正的自己。", "author": "伍绮诗", "from": "《无声告白》" },
    { "value": "每个人都在愤世嫉俗，但每个人都在随波逐流。", "author": "佚名" },
    { "value": "世界上只有一种真正的英雄主义，那就是认清生活的真相后依然热爱它。", "author": "罗曼·罗兰" },
    { "value": "你无法用战术上的勤奋，掩盖战略上的懒惰。", "author": "雷军" },
    { "value": "永远相信美好的事情即将发生。", "author": "雷军" },
    { "value": "站在风口上，猪都能飞起来。", "author": "雷军" },
    { "value": "商业的本质是创造价值，而不是榨取价值。", "author": "张一鸣" },
    { "value": "延迟满足感，是成年人最顶级的自律。", "author": "张一鸣" },
    { "value": "所谓成长，就是逼着你一个人，踉踉跄跄地受伤，跌跌撞撞地坚强。", "author": "佚名" },
    { "value": "读书是学习，摘抄是整理，写作是创造。", "author": "吴晗" },
    { "value": "欲高门第须为善；要好儿孙必读书。", "from": "《格言对联》" },
    { "value": "养心莫若寡欲；至乐无如读书。", "author": "郑成功" },
    { "value": "三更灯火五更鸡，正是男儿读书时；黑发不知勤学早，白首方悔读书迟。", "author": "颜真卿" },
    { "value": "读书，这个我们习以为常的平凡过程，实际上是人们心灵和上下古今一切民族的伟大智慧相结合的过程。", "author": "高尔基" },
    { "value": "读书的目的在于使自身成为有用人才。", "author": "方海权" },
    { "value": "教育！科学！学会读书，便是点燃火炬。", "author": "雨果" },
    { "value": "教学必须从学习者已有的经验开始。", "author": "杜威" },
    { "value": "如果学校不能在课堂中给予学生更多成功的体验，他们就会以既在学校内失败又在学校外失败而告终。", "author": "林格伦" },
    { "value": "为了在教学上取得预想的结果，单是指导学生的脑力活动是不够的，还必须在他身上树立起掌握知识的志向。", "author": "赞科夫" },
    { "value": "青年是学习智慧的时期，中年是付诸实践的时期。", "author": "卢梭" },
    { "value": "成功的秘诀，在永不改变既定的目的。", "author": "卢梭" },
    { "value": "读书无疑者，须教有疑，有疑者，却要无疑，到这里方是长进。", "author": "朱熹" },
    { "value": "善于选择要点就意味着节约时间。", "author": "培根" },
    { "value": "合理的安排时间，就等于节约时间。", "author": "培根" },
    { "value": "一切节约，归根到底都是时间的节约。", "author": "马克思" },
    { "value": "学习和钻研，要注意两个不良倾向：一个是浅尝辄止，一个是钻牛角尖。", "author": "马寅初" },
    { "value": "我们不需要死读硬记，我们需要用基本的知识来发展和增进每个学习者的思考力。", "author": "列宁" },
    { "value": "我们的事业就是学习再学习，努力积累更多的知识，因为有了知识，社会就会有长足的进步。", "author": "契诃夫" },
    { "value": "学而不用则废，用而不学则滞。", "author": "周海中" },
    { "value": "我贫穷，卑微，不美丽，但当我们的灵魂穿过坟墓来到上帝面前时，我们都是平等的。", "author": "夏洛蒂·勃朗特", "from": "《简·爱》" },
    { "value": "即使整个世界恨你，并且相信你很坏，只要你自己问心无愧，知道你是清白的，你就不会没有朋友。", "author": "夏洛蒂·勃朗特", "from": "《简·爱》" },
    { "value": "一个人至少拥有一个梦想，有一个理由去坚强。心若没有栖息的地方，到哪里都是流浪。", "author": "三毛" },
    { "value": "一朵孤芳自赏的花只是美丽，一片互相依恃着而怒放的锦绣才是灿烂。", "author": "席慕容" },
    { "value": "勇敢地离开，就像风筝那样，飞向蓝的，那么灼热的天。", "author": "饶雪漫" },
    { "value": "解放思想，发现自我，做真正的自己。", "author": "陈保军" },
    { "value": "人只要活着，就会有形。", "author": "陈保军" },
    { "value": "即使成功很难，我也要用一生奋斗追求。", "author": "闫江东" },
    { "value": "人；不要畏惧一切艰难，要敢于克服一切艰难。", "author": "闫江东" },
    { "value": "保持一种爱，学会欣赏美，惟有爱和美才是心灵的故乡。", "author": "林清玄" },
    { "value": "一个人面对外面的世界时，需要的是窗子；一个人面对自我时，需要的是镜子。", "author": "林清玄" },
    { "value": "一尘不染不是没有尘埃，而是尘埃任它飞扬，我自有我的阳光。", "author": "林清玄" },
    { "value": "心灵的房间，不打扫就会落满灰尘。蒙尘的心，会变得灰色和迷茫。", "author": "史铁生" },
    { "value": "人只有将寂寞坐断，才可以重拾喧闹；把悲伤过尽，才可以重见欢颜；把苦涩尝遍，就会自然回甘。", "author": "林徽因" },
    { "value": "你可以一辈子不登山，但你心中一定要有座山。它使你总是往高处爬，它使你总有个奋斗的方向，它使你任何一刻抬起头，都能看到自己的希望。", "author": "刘墉" },
    { "value": "成熟的标志，是依然保持一颗童心；成功了，却不虚荣，依然一颗平常心。", "author": "周国平" },
    { "value": "当过去不再照亮未来，人心将在黑暗中徘徊。", "author": "托克维尔", "from": "《旧制度与大革命》" },
    { "value": "平庸的恶，其本质是放弃思考、拒绝判断的盲从。", "author": "汉娜·阿伦特", "from": "《艾希曼在耶路撒冷》" },
    { "value": "即使是在黑暗的时代，我们也有权去期待一种启明。", "author": "汉娜·阿伦特", "from": "《黑暗时代的人们》" },
    { "value": "我们这个时代，因为它所独有的理性化和理智化，最主要的是因为世界已被祛魅，它的命运便是，那些终极的、最高贵的价值，已从公共生活中销声匿迹。", "author": "马克斯·韦伯", "from": "《学术与政治》" },
    { "value": "真正的责任伦理，是为自己的选择承担全部后果，哪怕前路遍布荆棘。", "author": "马克斯·韦伯", "from": "《学术与政治》" },
    { "value": "有两种东西，我们愈是时常反复地思索，它们就愈是给人的心灵灌注了时时翻新、有加无已的赞叹和敬畏：头顶的星空和心中的道德律。", "author": "康德", "from": "《实践理性批判》" },
    { "value": "自由不是想做什么就做什么，而是想不做什么就不做什么。", "author": "康德", "from": "《道德形而上学原理》" },
    { "value": "未经审视的人生，是不值得过的。", "author": "苏格拉底", "from": "《申辩篇》" },
    { "value": "我唯一知道的，就是我一无所知。", "author": "苏格拉底", "from": "《申辩篇》" },
    { "value": "那些杀不死我的，会使我更强大。", "author": "尼采", "from": "《善恶的彼岸》" },
    { "value": "在隆冬，我终于知道，我身上有一个不可战胜的夏天。", "author": "加缪", "from": "《夏天集》" },
    { "value": "对未来真正的慷慨，是把一切献给现在。", "author": "加缪", "from": "《反抗者》" },
    { "value": "对爱情的渴望，对知识的追求，对人类苦难不可遏制的同情心，这三种纯洁而无比强烈的激情支配着我的一生。", "author": "罗素", "from": "《我为什么而活着》" },
    { "value": "爱犹如一棵树，它的树根深植于地下，但它的枝条却可参天。", "author": "罗素" },
    { "value": "行者独步于遥远的旷野，素昧平生的未知，遭遇处处的难题，只因为一个执着的信任，敢于把世界上任何一片土地都放在脚下，为后来人度步出一往无垠的疆土。", "author": "余秋雨" },
    { "value": "生活不可能像你想象的那么好，但也不会像你想象的那么糟。人的脆弱和坚强都超乎自己的想象。", "author": "莫泊桑", "from": "《羊脂球》" },
    { "value": "有时，我可能脆弱得一句话就泪流满面，有时，也发现自己咬着牙走了很长的路。", "author": "莫泊桑", "from": "《羊脂球》" },
    { "value": "人最宝贵的是生命，生命对人来说只有一次。人的一生应当这样度过：当他回首往事时，不会因为碌碌无为，虚度年华而悔恨，也不会因为为人卑劣，生活庸俗而愧疚。", "author": "奥斯特洛夫斯基", "from": "《钢铁是怎样炼成的》" },
    { "value": "钢是在烈火里燃烧、高度冷却中炼成的，因此它很坚固。我们这一代人也是在斗争中和艰苦考验中锻炼出来的，并且学会了在生活中从不灰心丧气。", "author": "奥斯特洛夫斯基", "from": "《钢铁是怎样炼成的》" },
    { "value": "人应该支配习惯，而决不能让习惯支配人。", "author": "奥斯特洛夫斯基", "from": "《钢铁是怎样炼成的》" },
    { "value": "要抓紧时间赶快生活，因为一场莫名其妙的疾病，或者一个意外的悲惨事件，都会使生命中断。", "author": "奥斯特洛夫斯基", "from": "《钢铁是怎样炼成的》" },
    { "value": "人的生命似洪奔流，不遇着岛屿和暗礁，难以激起美丽的浪花。", "author": "奥斯特洛夫斯基" },
    { "value": "现实是此岸，理想是彼岸，中间隔着湍急的河流，行动则是架在河上的桥梁。", "author": "克雷诺夫" },
    { "value": "人的一生，总是为了追寻生命中的光，而走在漫长的旅途上。", "author": "星野道夫" },
    { "value": "如果一个人不知道他要驶向何处，那么任何方向都不是顺风。", "author": "赫利克特" },
    { "value": "你若光明，这世界就不会黑暗；你若心怀希望，这世界就不会彻底绝望；你如不屈服，这世界又能把你怎样。", "author": "曼德拉" },
    { "value": "善良是灵魂燃烧过的舍利——如火熄而碳犹暖，花谢而风仍香。", "author": "钱海燕" },
    { "value": "“真诚”有一种岩石般的纹理和坚定，不风化，不流失，不油腻，爽洁清晰，反射着钢蓝色的金属光泽。", "author": "毕淑敏" },
    { "value": "我可以接受失败，但绝不能接受没有奋斗过的自己。", "author": "宫崎骏" },
    { "value": "不管前方的路有多苦，只要走的方向正确，不管多么崎岖不平，都比站在原地更接近幸福。", "author": "宫崎骏" },
    { "value": "我们仍需要共生命的慷慨与繁华相爱，即使岁月以刻薄与荒芜相欺。", "author": "七堇年" },
    { "value": "生命从苦难中开始，只有在苦难中才能诞生灵魂的歌声。", "author": "路遥" },
    { "value": "人，不仅要战胜失败，而且还要超越胜利。不能把人生之船长期停泊在某个温暖的港湾，应该重新扬起风帆，驶向生活的惊涛骇浪中，以领略其间的无限风光。", "author": "路遥" },
    { "value": "生活不能等待别人来安排，要自己去争取和奋斗；而不论其结果是喜是悲，但可以慰藉的是，你总不枉在这世界上活了一场。", "author": "路遥", "from": "《平凡的世界》" },
    { "value": "向上的路总是坎坷又崎岖，要永远保持最初的浪漫，真是不容易。有人悲哀，有人欣喜，当我们跨越了一座高山，也就跨越了一个真实的自己。", "author": "汪国真" },
    { "value": "我们的欢乐，是母亲脸上的微笑；我们的痛苦，是母亲眼里深深的忧伤。我们可以走得很远很远，却总也走不出，母亲心灵的广场。", "author": "汪国真" },
    { "value": "一个不曾用自己的脚在路上踩下脚印的人，不会找到一条属于自己的路。", "author": "周国平" },
    { "value": "泰山不让土壤，故能成其大；河海不择细流，故能就其深。", "author": "李斯" },
    { "value": "人间没有永恒的夜晚，世界没有永恒的冬天。", "author": "艾青" },
    { "value": "冬天来了，春天还会远吗？", "author": "雪莱", "from": "《西风颂》" },
    { "value": "有些人一辈子都在骗自己，直到最后连自己都信了。", "from": "《无间道》" },
    { "value": "人生比电影难多了，电影有剧本，人生没有。", "from": "《天堂电影院》" },
    { "value": "有些人浅薄，有些人金玉其外败絮其中，但总有一天，你会遇到一个彩虹般绚丽的人。", "from": "《怦然心动》" },
    { "value": "为什么选择我？因为我不怕输。", "from": "《激战》" },
    { "value": "做人如果没有梦想，那跟咸鱼有什么分别？", "from": "《少林足球》" },
    { "value": "以前我没得选，现在我想做一个好人。", "from": "《无间道》" },
    { "value": "有些鸟是关不住的，它们的每一片羽毛都闪耀着自由的光辉。", "from": "《肖申克的救赎》" },
    { "value": "希望是个好东西，也许是世间最好的东西，好东西永远不会消逝的。", "from": "《肖申克的救赎》" },
    { "value": "人生总是这么痛苦吗？还是只有小时候是这样？", "from": "《这个杀手不太冷》" },
    { "value": "我们一路奋战，不是为了改变世界，而是为了不让世界改变我们。", "from": "《熔炉》" },
    { "value": "听过很多道理，依然过不好这一生。", "from": "《后会无期》" },
    { "value": "只有用心灵才能看清事物的本质，真正重要的东西是肉眼无法看见的。", "author": "圣-埃克苏佩里", "from": "《小王子》" },
    { "value": "我步入丛林，因为我希望生活得有意义，我希望活得深刻，汲取生命中所有的精华。", "author": "梭罗", "from": "《死亡诗社》" },
    { "value": "你如果不出去走走，你就会以为这就是全世界。", "from": "《天堂电影院》" },
    { "value": "我猜中了前头，可是我猜不着这结局。", "from": "《大话西游》" },
    { "value": "世界上最遥远的距离，不是生与死，而是我站在你面前，你却不知道我爱你。", "author": "张小娴", "from": "《世界上最遥远的距离》" },
    { "value": "所谓自由，不过就是一种漂泊；我错过声音的遗憾，胜过拥有过你的寂寞。", "from": "《东邪西毒》" },
    { "value": "当你年轻时，以为什么都有答案，可是老了的时候，你可能又觉得其实人生并没有所谓的答案。", "from": "《堕落天使》" },
    { "value": "如果多一张船票，你愿不愿意跟我一起走？", "from": "《花样年华》" },
    { "value": "我永远不会原谅你，但我可以原谅我自己。", "from": "《海边的曼彻斯特》" },
    { "value": "黑夜给了我黑色的眼睛，我却用它寻找光明。", "author": "顾城", "from": "《一代人》" },
    { "value": "草在结它的种子，风在摇它的叶子。我们站着，不说话，就十分美好。", "author": "顾城", "from": "《门前》" },
    { "value": "卑鄙是卑鄙者的通行证，高尚是高尚者的墓志铭。", "author": "北岛", "from": "《回答》" },
    { "value": "我不相信天是蓝的，我不相信雷的回声，我不相信梦是假的，我不相信死无报应。", "author": "北岛", "from": "《回答》" },
    { "value": "你若有一个不屈的灵魂，脚下就会有一片坚实的土地。", "author": "汪国真", "from": "《热爱生命》" },
    { "value": "既然选择了远方，便只顾风雨兼程。", "author": "汪国真", "from": "《热爱生命》" },
    { "value": "你是一树一树的花开，是燕在梁间呢喃，——你是爱，是暖，是希望，你是人间的四月天！", "author": "林徽因", "from": "《你是人间的四月天》" },
    { "value": "我打江南走过，那等在季节里的容颜如莲花的开落。", "author": "郑愁予", "from": "《错误》" },
    { "value": "如何让你遇见我，在我最美丽的时刻。为这，我已在佛前求了五百年。", "author": "席慕蓉", "from": "《一棵开花的树》" },
    { "value": "我如果爱你，绝不像攀援的凌霄花，借你的高枝炫耀自己。", "author": "舒婷", "from": "《致橡树》" },
    { "value": "乡愁是一湾浅浅的海峡，我在这头，大陆在那头。", "author": "余光中", "from": "《乡愁》" },
    { "value": "从明天起，做一个幸福的人，喂马、劈柴，周游世界。", "author": "海子", "from": "《面朝大海，春暖花开》" },
    { "value": "我只愿面朝大海，春暖花开。", "author": "海子" },
    { "value": "为什么我的眼里常含泪水？因为我对这土地爱得深沉。", "author": "艾青", "from": "《我爱这土地》" },
    { "value": "你站在桥上看风景，看风景的人在楼上看你。明月装饰了你的窗子，你装饰了别人的梦。", "author": "卞之琳", "from": "《断章》" },
    { "value": "我达达的马蹄是美丽的错误，我不是归人，是个过客。", "author": "郑愁予", "from": "《错误》" },
    { "value": "岁月极美，在于它必然的流逝。春花、秋月、夏日、冬雪。", "author": "三毛", "from": "《岁月》" },
    { "value": "心若没有栖息的地方，到哪里都是在流浪。", "author": "三毛" },
    { "value": "我慢慢地、慢慢地了解到，所谓父女母子一场，只不过意味着，你和他的缘分就是今生今世不断地在目送他的背影渐行渐远。", "author": "龙应台", "from": "《目送》" },
    { "value": "我们拼命地学习如何成功冲刺一百米，但是没有人教过我们：你跌倒时，怎么跌得有尊严。", "author": "龙应台", "from": "《跌倒》" },
    { "value": "Hope is a good thing, maybe the best of things, and no good thing ever dies.", "from": "《肖申克的救赎》" },
    { "value": "希望是美好的，也许是人间至善，而美好的事物永不消逝。", "from": "《肖申克的救赎》" },
    { "value": "Get busy living, or get busy dying.", "from": "《肖申克的救赎》" },
    { "value": "人生可以归结为一种简单的选择：不是忙着活，就是忙着死。", "from": "《肖申克的救赎》" },
    { "value": "Fear can hold you prisoner. Hope can set you free.", "from": "《肖申克的救赎》" },
    { "value": "恐惧让你沦为囚犯，希望让你重获自由。", "from": "《肖申克的救赎》" },
    { "value": "These walls are kind of funny like that. First you hate them, then you get used to them. Enough time passed, get so you depend on them. That's institutionalized.", "from": "《肖申克的救赎》" },
    { "value": "监狱里的高墙实在是很有趣。刚入狱的时候，你痛恨周围的高墙；慢慢地，你习惯了生活在其中；最终你会发现自己不得不依靠它而生存。这就是体制化。", "from": "《肖申克的救赎》" },
    { "value": "Some birds aren't meant to be caged. Their feathers are just too bright.", "from": "《肖申克的救赎》" },
    { "value": "有些鸟儿是注定不会被关在笼子里的，它们的每一片羽毛都闪耀着自由的光辉。", "from": "《肖申克的救赎》" },
    { "value": "It takes a strong man to save himself, and a great man to save another.", "from": "《肖申克的救赎》" },
    { "value": "强者自救，圣者渡人。", "from": "《肖申克的救赎》" },
    { "value": "I have no idea to this day what those two Italian ladies were singing about. Truth is, I don't want to know. Some things are better left unsaid.", "from": "《肖申克的救赎》" },
    { "value": "直到今天，我也不懂那两位意大利女士在唱什么。其实我也不想弄懂，有些事情最好不说。", "from": "《肖申克的救赎》" },
    { "value": "That's the beauty of music. They can't take that away from you.", "from": "《肖申克的救赎》" },
    { "value": "这就是音乐的美好，谁也无法从你心中夺走。", "from": "《肖申克的救赎》" },
    { "value": "There is something inside that they can't get to, that they can't touch. That's yours.", "from": "《肖申克的救赎》" },
    { "value": "你内心深处有种东西，他们碰不到、夺不走——那是属于你的。", "from": "《肖申克的救赎》" },
    { "value": "I hope I can make it across the border. I hope to see my friend, and shake his hand.", "from": "《肖申克的救赎》" },
    { "value": "我希望跨越边境，与朋友相见握手。", "from": "《肖申克的救赎》" },
    { "value": "I find I'm so excited. I can barely sit still or hold a thought in my head. I think it is the excitement only a free man can feel.", "from": "《肖申克的救赎》" },
    { "value": "我发现自己是如此的激动，以至于不能安坐或思考。我想只有那些重获自由的人才能感受到这种激动。", "from": "《肖申克的救赎》" },
    { "value": "Things that make you sad, one day, you will laugh out and say it.", "from": "《肖申克的救赎》" },
    { "value": "让你难过的事情，有一天你一定会笑着说出来。", "from": "《肖申克的救赎》" },
    { "value": "In our hearts, there is a place that cannot be locked. That place is called hope.", "from": "《肖申克的救赎》" },
    { "value": "在我们心里，有一块地方是无法锁住的，那块地方叫做希望。", "from": "《肖申克的救赎》" },
    { "value": "Prison life consists of routine, and then more routine.", "from": "《肖申克的救赎》" },
    { "value": "监狱生活充满了一段又一段的例行公事。", "from": "《肖申克的救赎》" },
    { "value": "You know what the Mexicans say about the Pacific? They say it has no memory.", "from": "《肖申克的救赎》" },
    { "value": "你知道墨西哥人怎么形容太平洋吗？他们说太平洋没有记忆。", "from": "《肖申克的救赎》" },
    { "value": "Salvation lies within.", "from": "《肖申克的救赎》" },
    { "value": "救赎之道，就在其中。（典狱长圣经扉页语，极具讽刺）", "from": "《肖申克的救赎》" },
    { "value": "On the outside, I was an honest man, straight as an arrow. I had to come to prison to be a crook.", "from": "《肖申克的救赎》" },
    { "value": "在外面我是个正直的人，结果却是在监狱里学会了犯罪。", "from": "《肖申克的救赎》" },
    { "value": "I believe in two things. Discipline and the Bible. Here, you'll receive both.", "from": "《肖申克的救赎》" },
    { "value": "我信奉两样东西：纪律与圣经。在这里，你两样都会得到。", "from": "《肖申克的救赎》" },
    { "value": "His Judgment Cometh and That Right Soon.", "from": "《肖申克的救赎》" },
    { "value": "主的审判，即刻降临。", "from": "《肖申克的救赎》" },
    { "value": "They send you here for life, and that’s exactly what they take.", "from": "《肖申克的救赎》" },
    { "value": "他们把你送进来服无期徒刑，而他们夺走的，也正是你的人生。", "from": "《肖申克的救赎》" },
    { "value": "For the briefest of moments, every last man at Shawshank felt free.", "from": "《肖申克的救赎》" },
    { "value": "在那短暂的一刻，肖申克里的每个人都感受到了自由。", "from": "《肖申克的救赎》" },
    { "value": "A warm place with no memory.", "from": "《肖申克的救赎》" },
    { "value": "一个温暖的、没有回忆的地方。", "from": "《肖申克的救赎》" },
    { "value": "My wife used to say I'm a hard man to know, like a closed book.", "from": "《肖申克的救赎》" },
    { "value": "我妻子曾说我是一个很难了解的人，像一本合上的书。", "from": "《肖申克的救赎》" },
    { "value": "Hope is a dangerous thing. Hope can drive a man insane.", "from": "《肖申克的救赎》" },
    { "value": "希望是件危险的事。希望能叫人发疯。", "from": "《肖申克的救赎》" },
    { "value": "I guess it comes down to a simple choice: get busy living or get busy dying.", "from": "《肖申克的救赎》" },
    { "value": "我想这归根结底是一个简单的选择：要么忙着生存，要么赶着去死。", "from": "《肖申克的救赎》" },
    { "value": "生而为人，我很抱歉。", "author": "太宰治", "from": "《人间失格》" },
    { "value": "我的不幸，恰恰在于我缺乏拒绝的能力。我害怕一旦拒绝别人，便会在彼此心里留下永远无法愈合的裂痕。", "author": "太宰治", "from": "《人间失格》" },
    { "value": "胆小鬼连幸福都会害怕，碰到棉花都会受伤，有时还被幸福所伤。", "author": "太宰治", "from": "《人间失格》" },
    { "value": "若能避开猛烈的欢喜，自然也不会有悲痛的来袭。", "author": "太宰治", "from": "《人间失格》" },
    { "value": "我这一生，尽是可耻之事。", "author": "太宰治", "from": "《人间失格》" },
    { "value": "无论对谁太过热情，就增加了不被珍惜的概率。", "author": "太宰治", "from": "《人间失格》" },
    { "value": "所谓的世人，不就是你吗？", "author": "太宰治", "from": "《人间失格》" },
    { "value": "多年以后，面对行刑队，奥雷里亚诺·布恩迪亚上校将会回想起父亲带他去见识冰块的那个遥远的下午。", "author": "加西亚·马尔克斯", "from": "《百年孤独》" },
    { "value": "过去都是假的，回忆是一条没有归途的路，以往的一切春天都无法复原。", "author": "加西亚·马尔克斯", "from": "《百年孤独》" },
    { "value": "无论走到哪里，都应该记住，过去都是假的，回忆是一条没有尽头的路。", "author": "加西亚·马尔克斯", "from": "《百年孤独》" },
    { "value": "这个家庭的历史是一架周而复始无法停息的机器，是一个转动着的轮子，这只齿轮，要不是轴会逐渐不可避免地磨损的话，会永远旋转下去。", "author": "加西亚·马尔克斯", "from": "《百年孤独》" },
    { "value": "遭受百年孤独的家族，注定不会在大地上第二次出现了。", "author": "加西亚·马尔克斯", "from": "《百年孤独》" },
    { "value": "如果你驯服了我，我们就互相不可缺少了。对我来说，你就是世界上唯一的了；我对你来说，也是世界上唯一的了。", "author": "圣-埃克苏佩里", "from": "《小王子》" },
    { "value": "星星发亮是为了让每一个人有一天都能找到属于自己的星星。", "author": "圣-埃克苏佩里", "from": "《小王子》" },
    { "value": "所有的大人都曾经是小孩，虽然，只有少数的人记得。", "author": "圣-埃克苏佩里", "from": "《小王子》" },
    { "value": "一旦你驯服了什么，就要对她负责，永远的负责。", "author": "圣-埃克苏佩里", "from": "《小王子》" },
    { "value": "审判自己比审判别人难多了。如果你成功地正确审判了自己，那么你就是一个真正的智者了。", "author": "圣-埃克苏佩里", "from": "《小王子》" },
    { "value": "一个人并不是生来要被打败的，你尽可以把他消灭掉，可就是打不败他。", "author": "海明威", "from": "《老人与海》" },
    { "value": "现在不是想你缺什么的时候，该想想凭手中的东西你能做什么。", "author": "海明威", "from": "《老人与海》" },
    { "value": "每一天都是一个新的日子。走运当然是好的，不过我情愿做到分毫不差。", "author": "海明威", "from": "《老人与海》" },
    { "value": "绝望是一种罪过。", "author": "海明威", "from": "《老人与海》" },
    { "value": "每逢你想要批评任何人的时候，你就记住，这个世界上所有的人，并不是个个都有过你拥有的那些优越条件。", "author": "菲茨杰拉德", "from": "《了不起的盖茨比》" },
    { "value": "于是我们奋力搏击，好比逆水行舟，不停地被水浪冲退，回到过去。", "author": "菲茨杰拉德", "from": "《了不起的盖茨比》" },
    { "value": "世界不会在意你的自尊，人们看到的只是你的成就。在你没有成就以前，切勿过分强调自尊。", "author": "菲茨杰拉德", "from": "《了不起的盖茨比》" },
    { "value": "满地都是六便士，他却抬头看见了月亮。", "author": "毛姆", "from": "《月亮与六便士》" },
    { "value": "我用尽了全力，过着平凡的一生。", "author": "毛姆", "from": "《月亮与六便士》" },
    { "value": "感情有理智根本无法理解的理由。", "author": "毛姆", "from": "《月亮与六便士》" },
    { "value": "追逐梦想就是追逐自己的厄运，在满地都是六便士的街上，他抬起头看到了月亮。", "author": "毛姆", "from": "《月亮与六便士》" },
    { "value": "人类的全部智慧就包含在这两个词里面：等待和希望！", "author": "大仲马", "from": "《基督山伯爵》" },
    { "value": "如果你渴望得到某样东西，你得让它自由，如果它回到你身边，它就是属于你的。", "author": "大仲马", "from": "《基督山伯爵》" },
    { "value": "开发人类智力的矿藏是少不了要由患难来促成的。", "author": "大仲马", "from": "《基督山伯爵》" },
    { "value": "一个不成熟男子的标志是他愿意为某种事业英勇地死去，一个成熟男子的标志是他愿意为某种事业卑贱地活着。", "author": "J.D.塞林格", "from": "《麦田里的守望者》" },
    { "value": "说来好笑。你千万别跟任何人谈任何事情。你只要一谈起，就会想念起每一个人。", "author": "J.D.塞林格", "from": "《麦田里的守望者》" },
    { "value": "记住该记住的，忘记该忘记的。改变能改变的，接受不能改变的。", "author": "J.D.塞林格", "from": "《麦田里的守望者》" },
    { "value": "你以为我贫穷、相貌平平就没有感情吗？我向你发誓，如果上帝赋予我财富和美貌，我会让你无法离开我，就像我现在无法离开你一样。", "author": "夏洛蒂·勃朗特", "from": "《简·爱》" },
    { "value": "假如你避免不了，就得去忍受。不能忍受生命中注定要忍受的事情，就是软弱和愚蠢的表现。", "author": "夏洛蒂·勃朗特", "from": "《简·爱》" },
    { "value": "世界上最宽阔的是海洋，比海洋更宽阔的是天空，比天空更宽阔的是人的心灵。", "author": "维克多·雨果", "from": "《悲惨世界》" },
    { "value": "释放无限光明的是人心，制造无边黑暗的也是人心。", "author": "维克多·雨果", "from": "《悲惨世界》" },
    { "value": "我宁愿靠自己的力量，打开我的前途，而不愿求有力者的垂青。", "author": "维克多·雨果", "from": "《悲惨世界》" },
    { "value": "没有被听见不是沉默的理由。", "author": "维克多·雨果", "from": "《悲惨世界》" },
    { "value": "宽宏大量，是惟一能够照亮伟大灵魂的光芒。", "author": "维克多·雨果", "from": "《巴黎圣母院》" },
    { "value": "人的心只容得下一定程度的绝望，海绵已经吸够了水，即使大海从它上面流过，也不能再给它增添一滴水了。", "author": "维克多·雨果", "from": "《巴黎圣母院》" },
    { "value": "人都是为希望而活，因为有了希望，人才有生活的勇气。", "author": "列夫·托尔斯泰", "from": "《安娜·卡列尼娜》" },
    { "value": "忠厚老实人的恶毒，像饭里的砂砾或者出骨鱼片里未净的刺，会给人一种不期待的伤痛。", "author": "钱钟书", "from": "《围城》" },
    { "value": "满纸荒唐言，一把辛酸泪。都云作者痴，谁解其中味。", "author": "曹雪芹", "from": "《红楼梦》" },
    { "value": "假作真时真亦假，无为有处有还无。", "author": "曹雪芹", "from": "《红楼梦》" },
    { "value": "世事洞明皆学问，人情练达即文章。", "author": "曹雪芹", "from": "《红楼梦》" },
    { "value": "其实我们每个人的生活都是一个世界，即使最平凡的人，也要为他生活的那个世界而奋斗。", "author": "路遥", "from": "《平凡的世界》" },
    { "value": "人，不仅要战胜失败，而且还要超越胜利。", "author": "路遥", "from": "《平凡的世界》" },
    { "value": "被真相伤害总比被谎言欺骗的好。", "author": "卡勒德·胡赛尼", "from": "《追风筝的人》" },
    { "value": "这是最好的时代，这是最坏的时代；这是智慧的年头，这是愚昧的年头。", "author": "狄更斯", "from": "《双城记》" },
    { "value": "我现在做的，是我一生中做过的最好、最最好的事情。", "author": "狄更斯", "from": "《双城记》" },
    { "value": "钢是在烈火里燃烧、高度冷却中炼成的，因此它很坚固。", "author": "奥斯特洛夫斯基", "from": "《钢铁是怎样炼成的》" },
    { "value": "只有我们醒来的那天，黎明才是黎明。", "author": "梭罗", "from": "《瓦尔登湖》" },
    { "value": "凡事需多听但少言；聆听他人之意见，但保留自己之判断。", "author": "莎士比亚", "from": "《哈姆雷特》" },
    { "value": "我知道这世界我无处容身，只是，你凭什么审判我的灵魂？", "author": "加缪", "from": "《局外人》" },
    { "value": "今天，妈妈死了。也许是昨天，我不知道。", "author": "加缪", "from": "《局外人》" },
    { "value": "我们之所以难以原谅别人，是因为我们无法原谅自己。", "author": "芥川龙之介", "from": "《罗生门》" }
  ],
  "学习": [
  ],
  "人民日报": [
    { "value": "星光不问赶路人，时光不负实干者。", "from": "《人民日报》" },
    { "value": "追风赶月莫停留，平芜尽处是春山。", "from": "《人民日报》" },
    { "value": "少年当有凌云志，万里长空竞风流。", "from": "《人民日报》" },
    { "value": "追光的人，终会光芒万丈。", "from": "《人民日报》" },
    { "value": "知不足而奋进，望远山而前行。", "from": "《人民日报》" },
    { "value": "流水不争先，争的是滔滔不绝。", "from": "《人民日报》" },
    { "value": "海压竹枝低复举，风吹山角晦还明。", "from": "《人民日报》" },
    { "value": "于高山之巅，方见大河奔涌；于群峰之上，更觉长风浩荡。", "from": "《人民日报》" },
    { "value": "凡心所向，素履所往，生如逆旅，一苇以航。", "from": "《人民日报》" },
    { "value": "夜色难免黑凉，前行必有曙光。", "from": "《人民日报》" },
    { "value": "总有人间一两风，填我十万八千梦。", "from": "《人民日报》" },
    { "value": "怀鸿鹄之志，展骐骥之跃。", "from": "《人民日报》" },
    { "value": "默默耕耘，静待花开。", "from": "《人民日报》" },
    { "value": "心有所期，全力以赴。", "from": "《人民日报》" },
    { "value": "微光成炬，照亮前路。", "from": "《人民日报》" },
    { "value": "未来如星辰大海般璀璨，不必踟蹰于过去的半亩方塘。", "from": "《人民日报》" },
    { "value": "少年气，是历经千帆举重若轻的沉淀，也是乐观坦然笑对生活的豁达。", "from": "《人民日报》" },
    { "value": "大河奔涌，九曲连环；万里黄河，气象万千。", "from": "《人民日报》" },
    { "value": "磨砺始得玉成，笃行方能致远。", "from": "《人民日报》" },
    { "value": "敢于有梦，没有什么山峰不能攀登；勇于追梦，没有什么急流不能横渡。", "from": "《人民日报》" },
    { "value": "惟其艰巨，所以伟大；惟其艰巨，更显荣光。", "from": "《人民日报》" },
    { "value": "时间坐标镌刻奋斗足迹，梦想征程闪耀如磐初心。", "from": "《人民日报》" },
    { "value": "想，全是问题；做，才有答案。", "from": "《人民日报》" },
    { "value": "你有多自律，就有多自由。", "from": "《人民日报》" },
    { "value": "所有难过，难是难，但总会过。", "from": "《人民日报》" },
    { "value": "蹉跎只能感动自己，行动才能打动别人。", "from": "《人民日报》" },
    { "value": "把行动交给现在，把结果交给时间。", "from": "《人民日报》" },
    { "value": "有输得起的勇气，才会有赢得到的底气。", "from": "《人民日报》" },
    { "value": "你自己不放弃，别人才有机会帮你。", "from": "《人民日报》" },
    { "value": "如果你热爱生活，生活一定比谁都清楚。", "from": "《人民日报》" },
    { "value": "你做三四月的事，在八九月自有答案。", "from": "《人民日报》" },
    { "value": "多一分坚持，就会少一分遗憾。", "from": "《人民日报》" },
    { "value": "那些难走的路，往往都是向上的路。", "from": "《人民日报》" },
    { "value": "想要成为什么人，就努力靠近什么样的人。", "from": "《人民日报》" },
    { "value": "勇敢地迈出第一步，是治愈焦虑的良药。", "from": "《人民日报》" },
    { "value": "有风有雨是人生的常态，迎难而上才能逆风翻盘。", "from": "《人民日报》" },
    { "value": "读书就是用最低廉的成本走最高级的成长路。", "from": "《人民日报》" },
    { "value": "你的迷茫，大多都是因为想得太多、做得太少。", "from": "《人民日报》" },
    { "value": "努力提升自己，永远比仰望别人有意义。", "from": "《人民日报》" },
    { "value": "脆弱的人总是有很多借口，但勇者却从不逃走。", "from": "《人民日报》" },
    { "value": "记住，能打败自己的永远只有下一秒的自己。", "from": "《人民日报》" },
    { "value": "躲起来的星星也在努力发光，你也要加油。", "from": "《人民日报》" },
    { "value": "焦虑不会消除明天的悲伤，它只会消耗今天的力量。", "from": "《人民日报》" },
    { "value": "愿你拥有坚如磐石的信念，还有无问西东的勇气。", "from": "《人民日报》" },
    { "value": "人生，从外打破是压力，从内打破是成长。", "from": "《人民日报》" },
    { "value": "真正困住你的不是困难本身，而是你对自己的负面暗示。", "from": "《人民日报》" },
    { "value": "无论是谁，只有努力多一点，人生的遗憾才会少一点。", "from": "《人民日报》" },
    { "value": "失望和希望，常常在同一条路上朝你走来。", "from": "《人民日报》" },
    { "value": "如果你不提前倒下，没有任何人可以打败你。", "from": "《人民日报》" },
    { "value": "你今天的一言一行，都是在为以后的成功谋篇布局。", "from": "《人民日报》" },
    { "value": "在哪里付出，就在哪里得到；在哪里打磨，就在哪里闪耀。", "from": "《人民日报》" },
    { "value": "不是因为看见了成功才坚持，是只有坚持才会看见成功。", "from": "《人民日报》" },
    { "value": "人生如同浪潮，每一次触底，都是为下一次反弹蓄力。", "from": "《人民日报》" },
    { "value": "成功其实很简单，就是比失败击倒你们的次数多一次。", "from": "《人民日报》" },
    { "value": "每当事情推进一步，你的迷茫就会减少一分。", "from": "《人民日报》" },
    { "value": "很多时候，能力决定你能走多快，人品决定你能走多远。", "from": "《人民日报》" },
    { "value": "不要只顾着欣赏他人的绚烂，而忘记了自己的芬芳。", "from": "《人民日报》" },
    { "value": "当你成长为一株向日葵，才能吸引来更多的阳光与正能量。", "from": "《人民日报》" },
    { "value": "人生的淡定和从容，都是从学到的本领修炼来的气定神闲。", "from": "《人民日报》" },
    { "value": "懂得适时转变位置，成为一束照亮别人的光，也才能被他人照耀。", "from": "《人民日报》" },
    { "value": "愿你历经风霜，依然初心不改，坚定走在自己的路上。", "from": "《人民日报》" },
    { "value": "我们的人生不是只有成功和失败两个词，坚持和奋斗同样有意义。", "from": "《人民日报》" },
    { "value": "从来没有一蹴而就的成功，所有熠熠闪光的背后都是默默的努力。", "from": "《人民日报》" },
    { "value": "接纳自己的不完美、肯定和认可自己，是我们这一生重要的课题。", "from": "《人民日报》" },
    { "value": "假如生活抛来一颗柠檬，你大可以选择把它榨成鲜美的柠檬汁。", "from": "《人民日报》" },
    { "value": "如果真的有谁能改变命运，推翻自己身上的偏见，那一定是你自己。", "from": "《人民日报》" },
    { "value": "把心放宽，该看开的看开，该放下的放下，才能看到不同的风景。", "from": "《人民日报》" },
    { "value": "自律和不自律，都会吃苦。不同的是，自律的苦会让人生越来越甜。", "from": "《人民日报》" },
    { "value": "远离不必要的计较和纠缠，把每一个平凡的日子都活出热气腾腾的样子。", "from": "《人民日报》" },
    { "value": "那些失意和受挫不过是人生的插曲，十年后回头再看，或许已成为财富。", "from": "《人民日报》" },
    { "value": "不要害怕一次的选择会改变自己的一生，要有一切推倒重来的勇气。", "from": "《人民日报》" },
    { "value": "没有完美的人生，但成熟的人，会懂得如何让自己变得更好。", "from": "《人民日报》" },
    { "value": "有梦想的人，总是知道自己要什么，一步一个脚印地让梦想离自己更近。", "from": "《人民日报》" },
    { "value": "好书也许不能立马带给你想要的成功，但它们一定能让你成为更好的自己。", "from": "《人民日报》" },
    { "value": "往后时光，愿你能扛事、懂翻篇，有静下来的力量，也有向内看的能力。", "from": "《人民日报》" },
    { "value": "每个人都想有所成就，却不知信手拈来的从容都是厚积薄发的沉淀。", "from": "《人民日报》" },
    { "value": "一次又一次的努力，会不断激发你的潜力，促使你成长为自己期待的样子。", "from": "《人民日报》" },
    { "value": "生活无关他人，只有你是自己人生的主角，与其取悦别人，不如好好爱自己。", "from": "《人民日报》" },
    { "value": "多学一项技能，生活就多开一道出口；多长一点本领，人生就有更多选择权。", "from": "《人民日报》" },
    { "value": "人品是底子，行为是面子，只有底子好，面子来映衬，人生才有更多的可能。", "from": "《人民日报》" },
    { "value": "只有付出比别人更多的努力和功夫，你才能在一次次磨砺中，变得闪闪发光。", "from": "《人民日报》" },
    { "value": "人生是一个不断提升自我的过程，你在哪里付出，就会在哪里收获。", "from": "《人民日报》" },
    { "value": "有很多时刻，你惊心动魄，而世界一无所知；你翻山越岭，而大地寂静无声。", "from": "《人民日报》" },
    { "value": "这个世界上的大部分传奇，不过是普普通通的人们，将心意化作了行动而已。", "from": "《人民日报》" },
    { "value": "努力的过程本就是孤岛，但最后抵达的一定是充满生机的彼岸。", "from": "《人民日报》" },
    { "value": "平和的接纳，不屈的奋斗，坚定的前行，如一泓清泉，静水流深。", "from": "《人民日报》" },
    { "value": "追求的后面没有句号，人生也永远没有太晚的开始。", "from": "《人民日报》" },
    { "value": "几代青年，皆以梦为马，不断探索中国未来。", "from": "《人民日报》" },
    { "value": "一个人真正的成熟，莫过于懂得耐住寂寞，深耕自己。", "from": "《人民日报》" },
    { "value": "人之所以要努力，是为了尽可能的把命运拽在自己手里。", "from": "《人民日报》" },
    { "value": "生活从来都是泥沙俱下，鲜花与荆棘并存。", "from": "《人民日报》" },
    { "value": "读书和赚钱，是人生最好的修行。前者让人不惑，后者让人有尊严。", "from": "《人民日报》" },
    { "value": "真正能给你撑腰的，是丰富的知识储备，足够的经济基础，持续的情绪稳定，可控的生活节奏，和那个打不败的自己。", "from": "《人民日报》" },
    { "value": "想要得到这世上最好的东西，得先让世界看到最好的你。", "from": "《人民日报》" },
    { "value": "少年应有鸿鹄志，当骑骏马踏平川。", "from": "《人民日报》" },
    { "value": "青春气贯长虹，勇锐盖过怯弱，进取压倒苟安。", "from": "《人民日报》" },
    { "value": "少年与爱永不老去，即便披荆斩棘，丢失怒马鲜衣。", "from": "《人民日报》" },
    { "value": "云程发轫，万里可期。", "from": "《人民日报》" },
    { "value": "九万里风鹏正举，举目起壮志；一百年长河浩荡，荡胸生豪情。", "from": "《人民日报》" },
    { "value": "我的肩上是风，风上是闪烁的星群。 生逢盛世，当不负盛世；生逢其时，当奋斗其时。", "from": "《人民日报》" },
    { "value": "时代的考题已经写下，我们的答案正在路上。", "from": "《人民日报》" },
    { "value": "山河无恙，烟火寻常，便是人间最好的模样。", "from": "《人民日报》" },
    { "value": "心向祖国，国能强；与时偕行，国能兴。", "from": "《人民日报》" },
    { "value": "隐隐之情俱系华夏，寸寸丹心皆为家国。", "from": "《人民日报》" },
    { "value": "峥嵘过去已经彪炳史册，璀璨当下正在不断延伸，光明未来需要踏实开拓。", "from": "《人民日报》" },
    { "value": "时代向前，青年向上，山河辽阔，你我皆是星光。", "from": "《人民日报》" },
    { "value": "每一份平凡的坚持，都闪耀着不凡的光芒。", "from": "《人民日报》" },
    { "value": "以微光汇聚星河，以平凡书写伟大。", "from": "《人民日报》" },
    { "value": "于无声处积蓄力量，于平凡中创造不凡。", "from": "《人民日报》" },
    { "value": "最慢的步伐不是跬步，而是徘徊；最快的脚步不是冲刺，而是坚持。", "from": "《人民日报》" },
    { "value": "心中有信仰，脚下有力量，眼里有光芒。", "from": "《人民日报》" },
    { "value": "凡是过往，皆为序章；凡是未来，皆有可期。", "from": "《人民日报》" },
    { "value": "跨越山海，奔赴热爱；心之所向，素履以往。", "from": "《人民日报》" },
    { "value": "心有热爱，何惧岁月漫长；步履不停，终会抵达远方。", "from": "《人民日报》" },
    { "value": "文化自信，是更基础、更广泛、更深厚的自信，是更基本、更深沉、更持久的力量。", "from": "《人民日报》" },
    { "value": "高扬中华民族的文化主体性，把历经沧桑留下的中华文明瑰宝呵护好、弘扬好、发展好。", "from": "《人民日报》" },
    { "value": "文化兴则国运兴，文化强则民族强。", "from": "《人民日报》" },
    { "value": "求木之长者，必固其根本；欲流之远者，必浚其泉源。", "from": "《人民日报》" },
    { "value": "传承不是复古，而是在坚守中创新；自信不是自满，而是在开放中自强。", "from": "《人民日报》" },
    { "value": "时代塑造了青年，青年影响了时代，处在新时代的中国青年更是生逢盛世、重任在肩。", "from": "《人民日报》" },
    { "value": "一切伟大成就，都是接续奋斗的结果；一切伟大事业，都需要在继往开来中推进。", "from": "《人民日报》" },
    { "value": "几代青年，皆以梦为马，不断探索中国未来。而今天的我们，则有机会把整个世界作为想象的行动的空间，去一展拳脚、实现抱负。", "from": "《人民日报》" },
    { "value": "日月不肯迟，四时相催迫。在这个属于奋斗者的新时代，人人都有追梦的权利，人人也都是梦想的筑造者。", "from": "《人民日报》" },
    { "value": "每次归程，都是为了更好出发；每次停歇，都是为了积攒力量。", "from": "《人民日报》" },
    { "value": "生活的真谛从来都不在别处，就在日常一点一滴的奋斗里。", "from": "《人民日报》" },
    { "value": "梦虽遥，追则能达；愿虽艰，持则可圆。", "from": "《人民日报》" },
    { "value": "再小的个子，也能给沙漠留下长长的影子；再平凡的人，也能为时代写下闪光的注脚。", "from": "《人民日报》" },
    { "value": "于高山之巅，方见大海奔涌；于群峰之上，更觉长风浩荡。", "from": "《人民日报》" },
    { "value": "逐梦的路上时有障碍，但只要全力以赴、无所畏惧，梦想终会绽放。", "from": "《人民日报》" },
    { "value": "时代之河川流不息，每一代青年都有自己的际遇和机缘，都要在自己所处的时代条件下谋划人生，创造历史。", "from": "《人民日报》" },
    { "value": "青松寒不落，碧海阔逾澄。时间这位伟大的魔术师，从不辜负对拼搏者的允诺，从不吝啬对奋斗者的褒奖。", "from": "《人民日报》" },
    { "value": "不负时代，不负韶华，不负心中那份滚烫的热爱。", "from": "《人民日报》" },
    { "value": "不惧风雨，不畏将来，保持热爱。", "from": "《人民日报》" },
    { "value": "信心如晨光，不争先，却驱散长夜。纵使暗影重重，心灯自明。", "from": "《人民日报》" },
    { "value": "莫问风浪几重，只需心火一盏。信心是灵魂的罗盘，无声指引方向。", "from": "《人民日报》" },
    { "value": "当世界低语“不可能”，信心是内心的回响。它不喧哗，却能震碎怀疑。", "from": "《人民日报》" },
    { "value": "信心在跌倒处生根，在站起时开花。别怕泥泞，每一步都刻着成长。", "from": "《人民日报》" },
    { "value": "静守方寸心田，信心如春溪流淌。不争朝夕，却润物无声。", "from": "《人民日报》" },
    { "value": "别让犹豫偷走翅膀，信心是飞向黎明的勇气。", "from": "《人民日报》" },
    { "value": "信心是写给未来的诗，落笔无悔。勿问值不值得，只问是否真诚。", "from": "《人民日报》" },
    { "value": "低谷时，信心是心底的暖阳。它不声张，却融化冰雪。", "from": "《人民日报》" },
    { "value": "在喧嚣中锚定内心，信心如磐石沉静。任潮起潮落，心自安稳。", "from": "《人民日报》" },
    { "value": "愿你的信心，如野草般柔韧，如星辰般恒久。", "from": "《人民日报》" },
    { "value": "嫩芽破土，不声张却撼动大地。成长是静默的扎根，伤口刻着年轮。", "from": "《人民日报》" },
    { "value": "跌倒时，大地教你如何稳行；站起后，风为你擦干泪痕。", "from": "《人民日报》" },
    { "value": "岁月如溪，无声漫过石阶，却将棱角磨成温润。", "from": "《人民日报》" },
    { "value": "在无人注视的角落，野草撕裂冻土。成长从不喧哗。", "from": "《人民日报》" },
    { "value": "心碎处，不是终点，而是光涌入的缝隙。", "from": "《人民日报》" },
    { "value": "别怕迷途，成长在转弯处悄然发生。", "from": "《人民日报》" },
    { "value": "晨露滴石，十年穿岩；成长是平凡日子的史诗。", "from": "《人民日报》" },
    { "value": "从“我做不到”到“我再试一次”，这一步丈量成长。", "from": "《人民日报》" },
    { "value": "成长是翅膀渐硬，却更懂泥土的温度。", "from": "《人民日报》" },
    { "value": "在柴米油盐中沉淀，在喧嚣世界里守心。", "from": "《人民日报》" },
    { "value": "星辰引路，脚步为歌。梦想不在远方，而在足下丈量。", "from": "《人民日报》" },
    { "value": "晨光未至，已启程。梦想无需完美起点，只需真诚一步。", "from": "《人民日报》" },
    { "value": "追逐不是奔跑，而是心跳的节奏。", "from": "《人民日报》" },
    { "value": "岁月如舟，载梦远航。不争朝夕，却日日向前。", "from": "《人民日报》" },
    { "value": "在风雨中护住心灯，梦想才不灭。", "from": "《人民日报》" },
    { "value": "一粒种子破土，始于无声的追逐。", "from": "《人民日报》" },
    { "value": "梦想是写给未来的信，落笔无悔。", "from": "《人民日报》" },
    { "value": "于柴米油盐中种梦，在喧嚣人间守心。", "from": "《人民日报》" },
    { "value": "愿你的梦想，如野草般柔韧，如星辰般恒久。", "from": "《人民日报》" },
    { "value": "志不立，天下无可成之事。", "from": "《人民日报》" },
    { "value": "功崇惟志，业广惟勤。", "from": "《人民日报》" },
    { "value": "少年负壮气，奋烈自有时。", "from": "《人民日报》" },
    { "value": "山再高，往上攀，总能登顶；路再长，走下去，定能到达。", "from": "《人民日报》" },
    { "value": "只有跋涉过最崎岖的山路，才能看见最壮丽的风景。", "from": "《人民日报》" },
    { "value": "日日行不怕千万里，天天讲不吝千万言，时时做不惧千万事。", "from": "《人民日报》" },
    { "value": "事业常成于坚忍，毁于急躁。", "from": "《人民日报》" },
    { "value": "时代在变，我们的征途是星辰大海。", "from": "《人民日报》" },
    { "value": "心怀山海，眼有星辰；永葆初心，不负韶华。", "from": "《人民日报》" },
    { "value": "理想指引人生方向，信念决定事业成败。", "from": "《人民日报》" },
    { "value": "把个人的小我融入祖国的大我、人民的大我之中。", "from": "《人民日报》" },
    { "value": "青年志存高远，就能激发奋进潜力。", "from": "《人民日报》" },
    { "value": "梦想一旦被付诸行动，就会变得神圣。", "from": "《人民日报》" },
    { "value": "未来属于那些相信梦想之美的人。", "from": "《人民日报》" },
    { "value": "心中有阳光，脚下有力量。", "from": "《人民日报》" },
    { "value": "你的梦想有多雄奇，中国就有多美丽。", "from": "《人民日报》" },
    { "value": "岁月因青春慨然以赴而更加静好，世间因少年挺身向前而更加瑰丽。", "from": "《人民日报》" },
    { "value": "青年一代有理想、有担当，国家就有前途，民族就有希望。", "from": "《人民日报》" },
    { "value": "人生的扣子从一开始就要扣好。", "from": "《人民日报》" },
    { "value": "让青春在奉献中焕发绚丽光彩。", "from": "《人民日报》" },
    { "value": "成长的道路上，既有鲜花，也有荆棘。", "from": "《人民日报》" },
    { "value": "刀在石上磨，人在事上练。", "from": "《人民日报》" },
    { "value": "不经一番寒彻骨，怎得梅花扑鼻香。", "from": "《人民日报》" },
    { "value": "当你不再轻易受外界干扰、开始独立思考时，你就获得了强大的力量。", "from": "《人民日报》" },
    { "value": "现在，青春是用来奋斗的；将来，青春是用来回忆的。", "from": "《人民日报》" },
    { "value": "平凡铸就伟大，英雄来自人民。每个人都了不起！", "from": "《人民日报》" },
    { "value": "世上没有从天而降的英雄，只有挺身而出的凡人。", "from": "《人民日报》" },
    { "value": "千难万险，尽心尽责就不惧风险；大计小计，人人有责是最佳之计。", "from": "《人民日报》" },
    { "value": "愿以吾辈之青春，守护这盛世之中华。", "from": "《人民日报》" },
    { "value": "立足本职岗位，创造不凡业绩。", "from": "《人民日报》" },
    { "value": "低谷潜心蛰伏，静待长风借力。 奋斗是生命的底色，坚持是抵达终点的船桨。", "from": "《人民日报》" },
    { "value": "没有风暴的海洋是池塘，没有跌倒的人生是童话。", "from": "《人民日报》" },
    { "value": "种子破土前，都经历过漫长的黑暗。", "from": "《人民日报》" },
    { "value": "所谓奇迹，不过是坚持的另一个名字。", "from": "《人民日报》" },
    { "value": "汗水浇灌的花，开得最晚却最芬芳。", "from": "《人民日报》" },
    { "value": "肩上有担当，脚下有力量。", "from": "《人民日报》" },
    { "value": "萤火虽微，愿为其芒；凡人微光，照亮山河。", "from": "《人民日报》" },
    { "value": "责任不是枷锁，而是托举生命的翅膀。", "from": "《人民日报》" },
    { "value": "传统是根，创新是叶，根深方能叶茂。", "from": "《人民日报》" },
    { "value": "参天之木必有其根，怀山之水必有其源。", "from": "《人民日报》" },
    { "value": "缓解焦虑最好的方法，就是去行动。想，都是问题；做，才有答案。", "from": "《人民日报》" },
    { "value": "不要一边担心未来，一边浪费现在。", "from": "《人民日报》" },
    { "value": "今天再大的事，到了明天就是小事，到了明年就是故事。", "from": "《人民日报》" },
    { "value": "事物的发展总是波浪式前进、螺旋式上升。", "from": "《人民日报》" },
    { "value": "请相信，未来的结局一定是会好的。如果不好，那就是还没到结局。", "from": "《人民日报》" },
    { "value": "正因为我有能力跨越，这个考验才会降临。", "from": "《人民日报》" },
    { "value": "没有人可以回到过去，但谁都可以从现在开始。", "from": "《人民日报》" },
    { "value": "不要只看见前方路途遥远，却忘了自己坚持了多久才走到这里。", "from": "《人民日报》" },
    { "value": "看不清方向时，就比旁人坚持久一点。", "from": "《人民日报》" },
    { "value": "努力，不是为了让别人觉得你了不起，而是为了能让自己看得起自己。", "from": "《人民日报》" },
    { "value": "看似不起眼的日复一日，会在将来的某一天，突然让你看到坚持的意义。", "from": "《人民日报》" },
    { "value": "如果没有天赋，那就一直重复。", "from": "《人民日报》" },
    { "value": "日日行不怕千万里，事事做不怕千万事。", "from": "《人民日报》" },
    { "value": "你努力了那么久，为什么不再往前跨一步呢？", "from": "《人民日报》" },
    { "value": "若你决定灿烂，山无遮，海无拦。", "from": "《人民日报》" },
    { "value": "风华正茂的年纪，你该所向披靡。", "from": "《人民日报》" },
    { "value": "不要成为风筝，要成为风。", "from": "《人民日报》" },
    { "value": "你不需要很厉害才开始，但你需要开始才能很厉害。", "from": "《人民日报》" },
    { "value": "实现梦想的过程从来都不轻松，我们要打败迷茫、委屈、懒惰、软弱。", "from": "《人民日报》" },
    { "value": "千万不要因为一时不顺，就怀疑自己的价值、怀疑努力的意义。", "from": "《人民日报》" },
    { "value": "真正能够登顶远眺的，永远是那些心无旁骛、坚持往前走的人。", "from": "《人民日报》" },
    { "value": "追逐梦想的路上，千万不要熄灭自己的光。", "from": "《人民日报》" },
    { "value": "当你拼尽全力，点点微光也能汇聚成束，通往未来的路就会被照亮。", "from": "《人民日报》" },
    { "value": "与其空想未来，不如专注现在，做好每一件眼前的事。", "from": "《人民日报》" },
    { "value": "树要成长，必先扎根，生活的真谛就在日常点滴的奋斗里。", "from": "《人民日报》" },
    { "value": "哪有那么多的天赋异禀，那些优秀的人都曾和你一样，默默地翻山越岭。", "from": "《人民日报》" },
    { "value": "今天迈出的每一小步，终会累积成为抵达梦想的一大步。", "from": "《人民日报》" },
    { "value": "人生从不是一条铺满鲜花的坦途，它充满未知与挑战。", "from": "《人民日报》" },
    { "value": "只要你有热情、有勇气，愿意为了心中梦想而不懈坚持，就算高山大海挡在前，也无法阻挡你前行的脚步。", "from": "《人民日报》" },
    { "value": "那些更加接近成功的人，即使面对重重考验，依然相信胜利在望。", "from": "《人民日报》" },
    { "value": "当你踮起脚尖使劲靠近太阳的时候，任谁也挡不住这耀眼的阳光。", "from": "《人民日报》" },
    { "value": "愿你勇敢追光，祝你光芒万丈！", "from": "《人民日报》" },
    { "value": "所有逆袭，都是有备而来；所有光芒，需要时间才能被看到。", "from": "《人民日报》" },
    { "value": "所有幸运，都是努力埋下的伏笔。", "from": "《人民日报》" },
    { "value": "真正的勇敢，不是只知道进，不知道退；而是在应进的时候，不退缩；该退的时候，不怕人嘲笑，敢于退让。", "from": "《人民日报》" },
    { "value": "最好的药物是忙碌，最好的治愈是读书；最好的爱情是自爱，最好的自爱是自律。", "from": "《人民日报》" },
    { "value": "水的清澈，并非因为它不含杂质，而是在于沉淀。心的通透，不是因为没有杂念，而是在于明白取舍。", "from": "《人民日报》" },
    { "value": "志之所趋，无远弗届，穷山距海，不能限也。", "from": "《人民日报》" },
    { "value": "正在追梦路上的你，无论身处何方，只管大胆追梦、努力圆梦。", "from": "《人民日报》" },
    { "value": "用心吃下的万般苦，终会化为未来的高光时刻。", "from": "《人民日报》" },
    { "value": "当人的热忱、奋斗与坚持，叠加时代的机遇、活力和托举，就能迸发出一骑绝尘的不凡力量。", "from": "《人民日报》" },
    { "value": "相信天道酬勤的道理，相信开放包容的时代，相信相信的力量。", "from": "《人民日报》" },
    { "value": "日复一日的奋斗，终将换来破茧成蝶的幸福。", "from": "《人民日报》" },
    { "value": "时间从不偏心，没有人突然成长。", "from": "《人民日报》" },
    { "value": "生活何以更好？梦想何以成真？答案就在此刻和脚下。", "from": "《人民日报》" },
    { "value": "伟大梦想不是等得来、喊得来的，而是拼出来、干出来的。", "from": "《人民日报》" },
    { "value": "信心从来不是盲目乐观，而是在乱云飞渡中保持“走好自己的路”的定力。", "from": "《人民日报》" },
    { "value": "信心赛过黄金。只要坚定信心、勇往直前，把奋斗刻写进历史的年轮，我们必将拥抱更加美好的生活。", "from": "《人民日报》" },
    { "value": "“狭路相逢勇者胜”，与困难角力、与阻力对垒，只有坚定必胜信心，才能踏平坎坷、筑就坦途。", "from": "《人民日报》" },
    { "value": "俯下身，倾耳听，那是时代的脉动、奋斗的足音。", "from": "《人民日报》" },
    { "value": "新征程上，每一个人都是主角。", "from": "《人民日报》" },
    { "value": "带着问题、带着思考、带着真情，走出去、扎下去，身入、深入、心入，与大地贴得更近，看天空也会更远。", "from": "《人民日报》" },
    { "value": "不啻微茫，造炬成阳。", "from": "《人民日报》" },
    { "value": "不必因为平凡而沮丧，不必因为渺小而自卑。", "from": "《人民日报》" },
    { "value": "一人微光，万人星河，平凡的我们，一样可以活成自己的太阳。", "from": "《人民日报》" },
    { "value": "人生最难得的，不是一时的领先，而是长久的坚持。", "from": "《人民日报》" },
    { "value": "慢慢来，稳一点，久一点，只要不停下，时间会给你最好的答案。", "from": "《人民日报》" },
    { "value": "市井长巷，聚拢来是烟火，摊开来是人间。", "from": "《人民日报》" },
    { "value": "三餐四季，家人闲坐，平安健康，便是最好的人生。", "from": "《人民日报》" },
    { "value": "珍惜眼前，珍惜日常，便是不负岁月，不负自己。", "from": "《人民日报》" },
    { "value": "显绩当做实，潜绩须做深。", "from": "《人民日报》" },
    { "value": "唯有在“深潜”中积蓄力量，在“疾驰”中彰显担当，方能创造出经得起实践、人民与历史检验的真正业绩。", "from": "《人民日报》" },
    { "value": "追求快，那是奋发向上的昂扬进取；选择慢，更显张弛有度的从容定力。", "from": "《人民日报》" },
    { "value": "疾行中不忘驻足，呵护悠久传统与厚重人文，我们不仅有中国速度，更有中国温度。", "from": "《人民日报》" },
    { "value": "信任不会凭空而来，而是在具体可感的尽责中，一次次被印证、得到滋养。", "from": "《人民日报》" },
    { "value": "毕业季是一段旅程的落幕，更是接过时代接力棒、奔赴下一程的起点。", "from": "《人民日报》" },
    { "value": "希望每一位毕业生都能心怀感恩、向阳生长，在各行各业大展身手。", "from": "《人民日报》" },
    { "value": "让教育的养分化作落地生根的强国力量。", "from": "《人民日报》" },
    { "value": "青年一代有“用青春之我创造青春之中国”的家国情怀，亦不乏“一起向未来”的人类情怀。", "from": "《人民日报》" },
    { "value": "越来越多中国青年正闪耀世界舞台，刷新世人的认知。", "from": "《人民日报》" },
    { "value": "他们不服输，勇于挺进无人区。", "from": "《人民日报》" },
    { "value": "从零突破的创新，总要有人勇挑重担、敢闯无人区。", "from": "《人民日报》" },
    { "value": "他们不信邪，敢在国际舞台跟老牌企业“掰手腕”、争长短。", "from": "《人民日报》" },
    { "value": "才智不凡，追求更不凡。", "from": "《人民日报》" },
    { "value": "一个个中国青年承先辈之志、开时代之新，让青春中国绽放青春光彩。", "from": "《人民日报》" },
    { "value": "仰望星空、抬头看路是中国青年身上的鲜明标识。", "from": "《人民日报》" },
    { "value": "脚踏实地、埋头耕耘则是他们身上的另一重品格。", "from": "《人民日报》" },
    { "value": "谁说年轻人心浮气躁？在日复一日的精耕细作中锤炼过硬本领，在平凡岗位上默默发光发热，书写下不凡的时代担当。", "from": "《人民日报》" },
    { "value": "如今的中国青年，不仅胸怀家国大义，还兼具全球视野。", "from": "《人民日报》" },
    { "value": "他们平视世界、放眼世界，具有开放自信的气度。", "from": "《人民日报》" },
    { "value": "青春之我，塑造青春中国；青春中国，为青年成长搭建舞台。", "from": "《人民日报》" },
    { "value": "这里有大有可为的机遇：完整的产业链条、广阔的产业蓝海、持续加码的科研投入以及开放包容的创新环境。", "from": "《人民日报》" },
    { "value": "这里还有大有作为的底气：“投资于人”深入人心，人才政策、科研扶持、生活保障多措并举，为青年减负撑腰。", "from": "《人民日报》" },
    { "value": "让青春闪耀，让理想翱翔，中国青年正与青春中国共成长。", "from": "《人民日报》" }
  ]
}
