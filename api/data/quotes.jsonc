// CyTime 云端语录数据（API 目录）
// 维护说明：
// - 顶层键即为 category，可自由增删分类。部署后 /api/v1/quote/categories 会自动返回这里的分类列表。
// - 每条语录包含 value（正文）、author（作者，可留空）、from（作品/出处，可留空）。
// - 支持 // 行注释与 /* 块注释 */。
// - 修改后提交推送即可，API 会读取本文件。

{
  "崩铁": [
    { "value": "但，即便命运确凿不移，无论它要将世界带向何方，只要我们能够共同面对，那就没什么好害怕的，对吧？", "author": "CyTime", "from": "逐火篇章" },
    { "value": "逐火的命路——由我们改写！", "author": "CyTime", "from": "逐火篇章" },
    { "value": "让「人」向你证明——自「毁灭」的温床中，也能开出温柔的花。", "author": "CyTime", "from": "逐火篇章" },
    { "value": "是我们赢了，「真诚」才是永远的捷径。", "author": "CyTime", "from": "逐火篇章" },
    { "value": "因为世界对我温柔，我就长成温柔的模样。", "author": "CyTime", "from": "逐火篇章" },
    { "value": "逐火是从不断失却，走向坚定舍却的旅途。", "author": "CyTime", "from": "逐火篇章" },
    { "value": "以爱为始的故事，也一定以爱为终♪", "author": "CyTime", "from": "逐火篇章" },
    { "value": "每一段回忆，都化作涟漪。", "author": "CyTime", "from": "逐火篇章" },
    { "value": "下一页是空白呢，那我们一起写下吧？", "author": "CyTime", "from": "逐火篇章" },
    { "value": "扔下多余的烦恼，把笑容和决心一起打包，带向明天♪", "author": "CyTime", "from": "逐火篇章" },
    { "value": "虔诚的叩问会得到同等重量的回应。", "author": "CyTime", "from": "逐火篇章" },
    { "value": "只有诗人知道，故事之外，有多少挣扎和痛苦。", "author": "CyTime", "from": "逐火篇章" },
    { "value": "说不定，我的心中也藏着一个阴谋呢…一个能让每个人都收获幸福的阴谋~", "author": "CyTime", "from": "逐火篇章" },
    { "value": "这世上没有任何一种语言，一行文字，能托得起这段旅途的重量。", "author": "CyTime", "from": "逐火篇章" },
    { "value": "一篇轰轰烈烈的史诗，要多么华美的语句才能勾勒出它的尾声呢？", "author": "CyTime", "from": "逐火篇章" }
  ],
  "名人名言": [
    { "value": "知识就是力量。", "author": "培根", "from": "《新工具》" },
    { "value": "我们无法选择时代，却可以选择如何回答时代。", "author": "CyTime", "from": "名人名言" },
    { "value": "真正的勇气，是在看清生活之后依然热爱生活。", "author": "CyTime", "from": "名人名言" }
  ],
  "原神": [
    { "value": "愿此行，终抵群星。", "author": "CyTime", "from": "原神" },
    { "value": "每一次探索，都是向未知递出的一封信。", "author": "CyTime", "from": "原神" }
  ],
  "学习": [
    { "value": "学习不是把答案装进脑海，而是学会提出更好的问题。", "author": "CyTime", "from": "学习" },
    { "value": "今天的积累，会成为明天从容的底气。", "author": "CyTime", "from": "学习" }
  ],
  "校园": [
    { "value": "少年应有凌云志，万里长空竞风流。", "author": "CyTime", "from": "校园" },
    { "value": "把每一件小事做好，就是最可靠的成长。", "author": "CyTime", "from": "校园" }
  ]
}
